# name: test/optimizer/pushdown/pushdown_projection_expression_rules.test
# description: A filter pushed through a computed projection or group is rewritten like a filter written on the table
# group: [pushdown]

statement ok
CREATE TABLE t AS SELECT i, i::VARCHAR AS s FROM range(100) tbl(i);

query I
SELECT count(*) FROM (SELECT i + 1 AS j FROM t) WHERE j > 90
----
10

query II
EXPLAIN SELECT count(*) FROM (SELECT i + 1 AS j FROM t) WHERE j > 90
----
physical_plan	<REGEX>:(?s).*Column Filter: i > 89.*

statement ok
CREATE TABLE t_int AS SELECT i::INTEGER AS i FROM range(100) tbl(i);

query I
SELECT count(*) FROM (SELECT CAST(i AS BIGINT) AS j FROM t_int) WHERE j > 90
----
9

query II
EXPLAIN SELECT count(*) FROM (SELECT CAST(i AS BIGINT) AS j FROM t_int) WHERE j > 90
----
physical_plan	<REGEX>:(?s).*Column Filter: i >= 91.*

query I
SELECT count(*) FROM (SELECT j FROM (SELECT i + 1 AS j FROM t) GROUP BY j) WHERE j > 90
----
10

query II
EXPLAIN SELECT count(*) FROM (SELECT j FROM (SELECT i + 1 AS j FROM t) GROUP BY j) WHERE j > 90
----
physical_plan	<REGEX>:(?s).*Column Filter: i > 89.*

query I
SELECT i FROM (SELECT i, [i, 0] AS l FROM t) WHERE l[1] = 5
----
5

query II
EXPLAIN SELECT i FROM (SELECT i, [i, 0] AS l FROM t) WHERE l[1] = 5
----
physical_plan	<!REGEX>:.*list_value.*

query I
SELECT i FROM (SELECT i, {'x': i} AS st FROM t) WHERE st.x = 5
----
5

query II
EXPLAIN SELECT i FROM (SELECT i, {'x': i} AS st FROM t) WHERE st.x = 5
----
physical_plan	<!REGEX>:.*struct_pack.*

query I
SELECT i FROM (SELECT i, s || s AS ss FROM t) WHERE ss || '!' = '55!'
----
5

query II
EXPLAIN SELECT i FROM (SELECT i, s || s AS ss FROM t) WHERE ss || '!' = '55!'
----
physical_plan	<REGEX>:(?s).*"\|\|"\(s, s, '!'\) = '55!'.*

# a filter through eight stacked computed projections, rewritten at each of them: one that folds becomes a table filter, one that no rule simplifies stays computed
query I
SELECT count(*) FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT i AS x FROM t))))))))) WHERE x > 90
----
17

query II
EXPLAIN SELECT count(*) FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT x + 1 AS x FROM (SELECT i AS x FROM t))))))))) WHERE x > 90
----
physical_plan	<REGEX>:(?s).*Column Filter: i > 82.*

query I
SELECT count(*) FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT s AS x FROM t))))))))) WHERE x = '24'
----
1

query II
EXPLAIN SELECT count(*) FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT reverse(x) AS x FROM (SELECT s AS x FROM t))))))))) WHERE x = '24'
----
physical_plan	<REGEX>:(?s).*reverse\(reverse\(reverse\(reverse\(reverse\(reverse\(reverse\(reverse\(s\)\)\)\)\)\)\)\) = '24'.*
