query IIIII
SELECT s7.x, r18.x, s2.adbin, s2.adnum, s0.objoid
FROM i_sat r0
  LEFT JOIN i_ip s0 ON EXISTS (SELECT true FROM i_coll)
  LEFT JOIN i_ad s2 ON EXISTS (SELECT s0.objoid FROM i_am WHERE s2.adnum IS NOT NULL)
  RIGHT JOIN i_sut r18 ON false
  RIGHT JOIN i_ext s7 ON NULL
ORDER BY 1
----
100	NULL	NULL	NULL	NULL
200	NULL	NULL	NULL	NULL
