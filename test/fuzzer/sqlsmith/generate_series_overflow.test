# name: test/fuzzer/sqlsmith/generate_series_overflow.test
# description: Fuzzer #26: overflow in generate series
# group: [sqlsmith]

statement ok
CREATE TABLE tbl(bigint BIGINT);

statement ok
INSERT INTO tbl VALUES(-9223372036854775808);

statement ok
INSERT INTO tbl VALUES(9223372036854775807);

statement ok
INSERT INTO tbl VALUES(NULL);

# At the top level of a SELECT list generate_series is a set-returning function here, as in
# PostgreSQL. Consuming the result as a function argument selects the list-returning overload,
# which is the one this file is about.

statement error
SELECT list_transform(generate_series(CAST(ref_0."bigint" AS BIGINT)), lambda x: x) AS c1 FROM tbl AS ref_0
----
<REGEX>:Invalid Input Error.*Lists larger.*not supported.*

statement error
SELECT list_transform(generate_series(-9223372036854775808, 9223372036854775807, 1), lambda x: x) AS c1
----
<REGEX>:Invalid Input Error.*Lists larger.*not supported.*

query I
SELECT list_transform(generate_series(9223372036854775805, 9223372036854775807, 1), lambda x: x) AS c1
----
[9223372036854775805, 9223372036854775806, 9223372036854775807]

query I
SELECT list_transform(generate_series(-9223372036854775806, -9223372036854775808, -1), lambda x: x) AS c1
----
[-9223372036854775806, -9223372036854775807, -9223372036854775808]
