# name: test/sql/connect/concurrent_connect_detach.test
# description: Concurrently route queries through CONNECT while detaching and reattaching the target
# group: [connect]

require quack

require httpfs

test-env QUACK_SERVER quack:localhost

statement ok
ATTACH '{QUACK_SERVER}' AS qk (TOKEN 'asdf');

concurrentloop threadid 0 8

loop iteration 0 30

onlyif threadid=0
statement maybe
DETACH qk;
----

onlyif threadid=0
statement maybe
ATTACH '{QUACK_SERVER}' AS qk (TOKEN 'asdf');
----

onlyif threadid>0
statement maybe
DISCONNECT;
----

onlyif threadid>0
statement maybe
CONNECT qk;
----

onlyif threadid>0
statement maybe
SELECT 42;
----

endloop

endloop
