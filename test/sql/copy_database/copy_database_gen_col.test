# name: test/sql/copy_database/copy_database_gen_col.test
# group: [copy_database]

load {TEST_DIR}/mydb.db

statement ok
CREATE TABLE test (x INT, y AS (x + 100));

statement ok
insert into test VALUES (42);

statement ok
FROM test;

statement ok
ATTACH '{TEST_DIR}/myotherdb.db';

statement ok
COPY FROM DATABASE mydb TO myotherdb;

query II
select * from myotherdb.test;
----
42	142

statement ok
ATTACH ':memory:' AS mem_src;

statement ok
ATTACH ':memory:' AS mem_dst;

statement ok
CREATE TABLE mem_src.stored_test (x INT, y AS (x + 100) STORED, z VARCHAR);

statement ok
insert into mem_src.stored_test (x, z) VALUES (42, 'a');

statement ok
COPY FROM DATABASE mem_src TO mem_dst;

statement ok
insert into mem_dst.stored_test (x, z) VALUES (1, 'b');

query III
select * from mem_dst.stored_test order by x;
----
1	101	b
42	142	a
