# name: test/sql/optimizer/constant_in_list.test
# description: IN lists of five to 32 constants stay IN expressions evaluated in one typed pass, with SQL NULL semantics; longer lists still become joins
# group: [optimizer]

statement ok
CREATE TABLE t AS SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 50 END::INTEGER AS n, (i % 7)::TINYINT AS b, (i * 0.5)::DOUBLE AS d,
    'v' || (i % 20)::VARCHAR AS s, DATE '2024-01-01' + (i % 30)::INTEGER AS dt, (i % 40)::DECIMAL(10, 2) AS dec, (i % 9)::HUGEINT AS h
FROM range(5000) r(i);

query II
EXPLAIN SELECT count(*) FROM t WHERE n IN (1, 2, 3, 229, 2, 208, 158, 34, 47);
----
physical_plan	<!REGEX>:.*HASH_JOIN.*

query II
EXPLAIN SELECT count(*) FROM t WHERE n IN (0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 45, 48, 51, 54, 57, 60, 63, 66, 69, 72, 75, 78, 81, 84, 87, 90, 93, 96, 99, 102, 105, 108, 111, 114, 117);
----
physical_plan	<REGEX>:.*HASH_JOIN.*

query I
SELECT count(*) FROM t WHERE (n IN (1, 2, 3, 29, 34, 47, 49)) IS DISTINCT FROM (n = 1 OR n = 2 OR n = 3 OR n = 29 OR n = 34 OR n = 47 OR n = 49);
----
0

query I
SELECT count(*) FROM t WHERE (n NOT IN (1, 2, 3, 29, 34, 47)) IS DISTINCT FROM (n <> 1 AND n <> 2 AND n <> 3 AND n <> 29 AND n <> 34 AND n <> 47);
----
0

query I
SELECT count(*) FROM t WHERE (n IN (1, 2, 3, NULL, 34, 47)) IS DISTINCT FROM (n = 1 OR n = 2 OR n = 3 OR n = NULL OR n = 34 OR n = 47);
----
0

query I
SELECT count(*) FROM t WHERE (n NOT IN (1, 2, 3, NULL, 34, 47)) IS DISTINCT FROM (n <> 1 AND n <> 2 AND n <> 3 AND n <> NULL AND n <> 34 AND n <> 47);
----
0

query IIIIII
SELECT count(*) FILTER (WHERE b IN (1, 2, 3, 5, 6)), count(*) FILTER (WHERE d IN (0.5, 1.0, 2.5, 100.0, 7.5)),
    count(*) FILTER (WHERE s IN ('v1', 'v2', 'v3', 'v19', 'nope')), count(*) FILTER (WHERE dt IN (DATE '2024-01-02', DATE '2024-01-03', DATE '2024-01-05', DATE '2024-01-30', DATE '2023-01-01')),
    count(*) FILTER (WHERE dec IN (1.00, 2.00, 3.50, 39.00, 7.00)), count(*) FILTER (WHERE h IN (1, 2, 3, 4, 8))
FROM t;
----
3571	5	1000	667	500	2779

query I
SELECT count(*) FROM t WHERE n IN (0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 45, 48, 51, 54, 57, 60, 63, 66, 69, 72, 75, 78, 81, 84, 87, 90, 93, 96, 99, 102, 105, 108, 111, 114, 117);
----
1569

query I
SELECT list(x ORDER BY x) FROM (VALUES (1), (NULL), (3), (7)) v(x) WHERE x IN (1, 2, 3, 4, 5, 6);
----
[1, 3]

query I
SELECT n IN (1, 2, 3, 4, 5) FROM (VALUES (NULL::INTEGER)) v(n);
----
NULL

query I
SELECT 9 NOT IN (1, 2, 3, 4, NULL);
----
NULL
