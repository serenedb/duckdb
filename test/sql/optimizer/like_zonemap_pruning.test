# name: test/sql/optimizer/like_zonemap_pruning.test
# description: Row groups are pruned for LIKE, LIKE ... ESCAPE and GLOB patterns that stay LIKE, by the literal prefix and the shortest match
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/like_zonemap_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

statement ok
CREATE TABLE t AS
SELECT CASE
           WHEN range < 2048 THEN 'aaa' || (range % 1000)::VARCHAR
           WHEN range < 4096 THEN 'mmm' || range::VARCHAR
           ELSE 'zzz' || range::VARCHAR
       END AS s
FROM range(6144);

statement ok
CREATE TABLE pats(id INTEGER, kind VARCHAR, p VARCHAR, e VARCHAR)

statement ok
INSERT INTO pats VALUES (1, 'like', 'mmm_1%', NULL), (2, 'like', 'mmm%9', NULL), (3, 'like', 'q_q%', NULL), (4, 'escape', 'zzz6#1_%', '#'), (5, 'like', 'a\aa_9%', NULL), (6, 'like', '%_______%', NULL), (7, 'like', '%______%', NULL), (8, 'glob', 'mmm?1*', NULL), (9, 'glob', 'mm[a-m]*', NULL), (10, 'not_like', 'mmm_1%', NULL), (11, 'like', '%m_m%', NULL)

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE 'mmm_1%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE 'mmm%9';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE 'q_q%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 0 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE 'zzz6#1_%' ESCAPE '#';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE 'a\aa_9%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE '%_______%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 2 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE '%______%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s GLOB 'mmm?1*';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s GLOB 'mm[a-m]*';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s NOT LIKE 'mmm_1%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE s LIKE '%m_m%';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query IIIIIIIIIII
SELECT (SELECT count(*) FROM t WHERE s LIKE 'mmm_1%'), (SELECT count(*) FROM t WHERE s LIKE 'mmm%9'), (SELECT count(*) FROM t WHERE s LIKE 'q_q%'), (SELECT count(*) FROM t WHERE s LIKE 'zzz6#1_%' ESCAPE '#'), (SELECT count(*) FROM t WHERE s LIKE 'a\aa_9%'), (SELECT count(*) FROM t WHERE s LIKE '%_______%'), (SELECT count(*) FROM t WHERE s LIKE '%______%'), (SELECT count(*) FROM t WHERE s GLOB 'mmm?1*'), (SELECT count(*) FROM t WHERE s GLOB 'mm[a-m]*'), (SELECT count(*) FROM t WHERE s NOT LIKE 'mmm_1%'), (SELECT count(*) FROM t WHERE s LIKE '%m_m%')
----
200	205	0	44	201	4096	5896	200	2048	5944	2048

query IIIIIIIIIII
SELECT count(*) FILTER (WHERE id = 1), count(*) FILTER (WHERE id = 2), count(*) FILTER (WHERE id = 3), count(*) FILTER (WHERE id = 4), count(*) FILTER (WHERE id = 5), count(*) FILTER (WHERE id = 6), count(*) FILTER (WHERE id = 7), count(*) FILTER (WHERE id = 8), count(*) FILTER (WHERE id = 9), count(*) FILTER (WHERE id = 10), count(*) FILTER (WHERE id = 11) FROM t, pats WHERE CASE kind WHEN 'like' THEN s LIKE p WHEN 'escape' THEN s LIKE p ESCAPE e WHEN 'glob' THEN s GLOB p ELSE s NOT LIKE p END
----
200	205	0	44	201	4096	5896	200	2048	5944	2048

statement error
SELECT count(*) FROM t WHERE s LIKE 'aaa\';
----
LIKE pattern must not end with escape character

statement error
SELECT count(*) FROM t WHERE s LIKE 'qqq' ESCAPE 'ab';
----
invalid escape string
