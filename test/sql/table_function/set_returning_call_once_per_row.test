# name: test/sql/table_function/set_returning_call_once_per_row.test
# description: Identical set-returning calls in one select list are evaluated once per row
# group: [table_function]

statement ok
CREATE MACRO pairs(n) AS TABLE SELECT random() AS r, i FROM range(n) t(i)

statement ok
CREATE SEQUENCE seq

statement ok
CREATE MACRO numbered(n) AS TABLE SELECT nextval('seq') AS v, i FROM range(n) t(i)

statement ok
CREATE MACRO options_of(o) AS TABLE SELECT split_part(x, '=', 1) AS option_name, split_part(x, '=', 2) AS option_value FROM unnest(o) t(x)

statement ok
CREATE TABLE rel(id INT, reloptions VARCHAR[])

statement ok
INSERT INTO rel VALUES (1, ['fillfactor=70', 'autovacuum_enabled=off']), (2, NULL), (3, ['fillfactor=90'])

query II
SELECT (pairs(3)).i, (pairs(3)).r = (pairs(3)).r
----
0	true
1	true
2	true

query II
SELECT (numbered(3)).v, (numbered(3)).i
----
1	0
2	1
3	2

query I
SELECT currval('seq')
----
3

query III
SELECT id, (options_of(reloptions)).option_name, (options_of(reloptions)).option_value FROM rel ORDER BY ALL
----
1	autovacuum_enabled	off
1	fillfactor	70
3	fillfactor	90

query II
SELECT (pairs(2)).i, (pairs(3)).i
----
0	0
1	1
NULL	2

statement error
SELECT (pairs(2)).i, sum((pairs(2)).i)
----
UNNEST not supported here

statement error
SELECT (pairs(2)).i, row_number() OVER (ORDER BY (pairs(2)).i)
----
UNNEST not supported here

statement ok
CREATE SEQUENCE plain_seq

query I
SELECT a <> b FROM (SELECT unnest([nextval('plain_seq')]) AS a, unnest([nextval('plain_seq')]) AS b)
----
true
