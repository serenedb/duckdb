# name: test/sql/peg_parser/fuzzer/diverge_0014.test
# description: RESET LOCAL is implemented, and rejected outside a transaction block
# group: [fuzzer]

statement ok
EXPLAIN RESET LOCAL result

statement error
RESET LOCAL allowed_paths
----
RESET LOCAL can only be used in transaction blocks

statement ok
BEGIN

statement ok
RESET LOCAL search_path

statement ok
COMMIT

# a global-only option cannot be reset for the transaction alone
statement ok
BEGIN

statement error
RESET LOCAL allowed_paths
----
cannot be reset locally

statement ok
ROLLBACK
