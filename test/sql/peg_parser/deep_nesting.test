# name: test/sql/peg_parser/deep_nesting.test
# description: Test deeply nested input with the PEG parser
# group: [peg_parser]

query I
FROM query('SELECT ' || repeat('(', 5000) || '1' || repeat(')', 5000));
----
1

# Exercise nested list expressions through transformation and binding.
foreach depth 1 10 100

query I
FROM query('SELECT (' || repeat('[', {depth}) || '1' || repeat(']', {depth}) || ') IS NOT NULL');
----
1

endloop

query I
FROM query('SELECT ' || repeat('1 - (2 - (', 50) || '3' || repeat('))', 50));
----
-47

statement error
FROM query('SELECT (' || repeat('[', 300000) || '1' || repeat(']', 300000) || ') IS NOT NULL AS result');
----
<REGEX>:.*stack depth limit exceeded.*

query I
FROM query('SELECT (NULL::INT' || repeat('[]', 100) || ') IS NULL');
----
true

statement error
FROM query('SELECT (NULL::INT' || repeat('[]', 300000) || ') IS NULL');
----
<REGEX>:.*stack depth limit exceeded.*
