# name: test/sql/filter/test_between_nested.test
# group: [filter]

statement ok
CREATE TABLE points(id INTEGER, p STRUCT(x INTEGER, y HUGEINT), l INTEGER[]);

statement ok
INSERT INTO points SELECT i, {'x': i % 4, 'y': i // 4}, [i % 4, i // 4] FROM range(5000) t(i);

statement ok
INSERT INTO points VALUES (5000, NULL, NULL), (5001, {'x': NULL, 'y': 1}, [NULL, 1]);

query I
SELECT count(*) FROM points WHERE p BETWEEN {'x': 1, 'y': 100} AND {'x': 1, 'y': 200};
----
101

query I
SELECT count(*) FROM points WHERE p >= {'x': 1, 'y': 100} AND p <= {'x': 1, 'y': 200};
----
101

query I
SELECT count(*) FROM points WHERE p > {'x': 1, 'y': 100} AND p < {'x': 1, 'y': 200};
----
99

query I
SELECT count(*) FROM points WHERE p NOT BETWEEN {'x': 1, 'y': 100} AND {'x': 3, 'y': 200};
----
2400

query I
SELECT count(*) FROM points WHERE l BETWEEN [1, 100] AND [1, 200];
----
101

query I
SELECT count(*) FROM points WHERE l > [1, 100] AND l < [1, 200];
----
99

query I
SELECT count(*) FROM points WHERE p BETWEEN {'x': 1, 'y': 100} AND {'x': 1, 'y': 200} AND id % 8 = 1;
----
51

query I
SELECT count(*) FILTER (WHERE p BETWEEN {'x': 1, 'y': 100} AND {'x': 1, 'y': 200}) FROM points;
----
101
