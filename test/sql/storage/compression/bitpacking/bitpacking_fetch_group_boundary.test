# name: test/sql/storage/compression/bitpacking/bitpacking_fetch_group_boundary.test
# description: Point fetch of a row sitting exactly on a bitpacking metadata group boundary
# group: [bitpacking]

# A skip that ends exactly on a metadata group boundary defers the group load;
# scans roll over lazily, but FetchRow reads group-relative pointers directly.
# An index scan fetches matched rows by rowid, so hitting rows 2048/4096 goes
# through FetchRow with a boundary skip.

require block_size 262144

load {TEST_DIR}/test_bitpacking_fetch.db

# Force the planner onto the ART index path so matches are point-fetched.
statement ok
SET index_scan_percentage = 1.0;

statement ok
SET index_scan_max_count = 0;

statement ok
PRAGMA force_compression = 'bitpacking'

foreach bitpacking_mode delta_for for constant_delta

statement ok
PRAGMA force_bitpacking_mode='{bitpacking_mode}'

statement ok
CREATE TABLE test (x BIGINT PRIMARY KEY, label VARCHAR);

statement ok
INSERT INTO test SELECT i, 'l' || i FROM range(0, 10000) tbl(i);

statement ok
CHECKPOINT;

query II
SELECT x, label FROM test WHERE x = 2047;
----
2047	l2047

query II
SELECT x, label FROM test WHERE x = 2048;
----
2048	l2048

query II
SELECT x, label FROM test WHERE x = 4096;
----
4096	l4096

query II
SELECT x, label FROM test WHERE x = 9999;
----
9999	l9999

statement ok
DROP TABLE test;

endloop
