SELECT count(*), count(*) FILTER (WHERE id < 100000 AND u IS NOT DISTINCT FROM (CASE WHEN id % 7 = 0 THEN NULL ELSE -id END)), count(*) FILTER (WHERE id > 100000 AND u IS NOT DISTINCT FROM (CASE WHEN (id - 100000) % 7 = 0 THEN NULL ELSE (id - 100000) END)) FROM b_roaring_validity;
----
40020	20010	20010

# roaring bool
statement ok
PRAGMA force_compression = 'roaring';

statement ok
CREATE TABLE t_roaring_bool (id INTEGER PRIMARY KEY, v BOOLEAN);

statement ok
INSERT INTO t_roaring_bool SELECT i, i % 3 = 0 FROM range(1, 20011) r(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 0 FROM pragma_storage_info('t_roaring_bool') WHERE column_name = 'v' AND segment_type = 'BOOLEAN' AND compression ILIKE 'roaring';
----
true

# the index scan fetches the rows it finds by row id
query II
SELECT id, v IS NOT DISTINCT FROM (id % 3 = 0) FROM t_roaring_bool WHERE id IN (20010, 3, 10000, 1, 7777) ORDER BY id;
----
1	true
3	true
7777	true
10000	true
20010	true

statement ok
BEGIN;

# joined with a larger source in descending order, the UPDATE of every tenth row fetches the previous values of v
# of the rows it updates in a descending row id order
statement ok
UPDATE t_roaring_bool SET v = t_roaring_bool.id % 3 <> 0 FROM (SELECT i FROM range(300000, 0, -10) r(i)) src WHERE t_roaring_bool.id = src.i;

# the rollback restores the previous values that the UPDATE fetched
statement ok
ROLLBACK;

query II
SELECT count(*), count(*) FILTER (WHERE v IS NOT DISTINCT FROM (id % 3 = 0)) FROM t_roaring_bool;
----
20010	20010

statement ok
UPDATE t_roaring_bool SET v = t_roaring_bool.id % 3 <> 0 FROM (SELECT i FROM range(300000, 0, -10) r(i)) src WHERE t_roaring_bool.id = src.i;

query II
SELECT count(*) FILTER (WHERE id % 10 = 0 AND v IS NOT DISTINCT FROM (id % 3 <> 0)), count(*) FILTER (WHERE id % 10 <> 0 AND v IS NOT DISTINCT FROM (id % 3 = 0)) FROM t_roaring_bool;
----
2001	18009
