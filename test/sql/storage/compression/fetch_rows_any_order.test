# name: test/sql/storage/compression/fetch_rows_any_order.test
# description: Rows of the segments of each compression fetched by row id, also in a descending order
# group: [compression]

load {TEST_DIR}/test_fetch_rows_any_order.db readwrite v1.5.0

# rle
statement ok
PRAGMA force_compression = 'rle';

statement ok
CREATE TABLE t_rle (id INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO t_rle SELECT i, i // 3 FROM range(1, 20011) r(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 0 FROM pragma_storage_info('t_rle') WHERE column_name = 'v' AND segment_type <> 'VALIDITY' AND compression ILIKE 'rle';
----
true

# the index scan fetches the rows it finds by row id
query II
SELECT id, v IS NOT DISTINCT FROM (id // 3) FROM t_rle WHERE id IN (20010, 3, 10000, 1, 7777) ORDER BY id;
----
1	true
3	true
7777	true
10000	true
20010	true

statement ok
BEGIN;

# joined with a larger source in descending order, the UPDATE of every tenth row fetches the previous values of v
# of the rows it updates in a descending row id order
statement ok
UPDATE t_rle SET v = -t_rle.id FROM (SELECT i FROM range(300000, 0, -10) r(i)) src WHERE t_rle.id = src.i;

# the rollback restores the previous values that the UPDATE fetched
statement ok
ROLLBACK;

query II
SELECT count(*), count(*) FILTER (WHERE v IS NOT DISTINCT FROM (id // 3)) FROM t_rle;
----
20010	20010

statement ok
UPDATE t_rle SET v = -t_rle.id FROM (SELECT i FROM range(300000, 0, -10) r(i)) src WHERE t_rle.id = src.i;

query II
SELECT count(*) FILTER (WHERE id % 10 = 0 AND v IS NOT DISTINCT FROM (-id)), count(*) FILTER (WHERE id % 10 <> 0 AND v IS NOT DISTINCT FROM (id // 3)) FROM t_rle;
----
2001	18009

statement ok
CREATE TABLE k_rle (id INTEGER, u INTEGER UNIQUE);

statement ok
INSERT INTO k_rle SELECT i, CASE WHEN i % 4 = 1 THEN i ELSE NULL END FROM range(1, 20011) r(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 0 FROM pragma_storage_info('k_rle') WHERE column_name = 'u' AND segment_type <> 'VALIDITY' AND compression ILIKE 'rle';
----
true

statement ok
BEGIN;

# the UPDATE does not read u, so it fetches the previous values of u for its delete index, one row at a time in
# the descending row order of its join
statement ok
UPDATE k_rle SET u = CASE WHEN src.i % 4 = 1 THEN -src.i ELSE NULL END FROM (SELECT i FROM range(30000, 0, -1) r(i)) src WHERE k_rle.id = src.i;

# a previous value that did not reach the delete index fails as a duplicate key
statement ok
INSERT INTO k_rle SELECT i + 100000, CASE WHEN i % 4 = 1 THEN i ELSE NULL END FROM range(1, 20011) r(i);

statement ok
COMMIT;

query III
SELECT count(*), count(*) FILTER (WHERE id < 100000 AND u IS NOT DISTINCT FROM (CASE WHEN id % 4 = 1 THEN -id ELSE NULL END)), count(*) FILTER (WHERE id > 100000 AND u IS NOT DISTINCT FROM (CASE WHEN (id - 100000) % 4 = 1 THEN (id - 100000) ELSE NULL END)) FROM k_rle;
----
40020	20010	20010

statement ok
CREATE TABLE b_rle (id INTEGER, u INTEGER UNIQUE);

statement ok
INSERT INTO b_rle SELECT i, CASE WHEN i % 4 = 1 THEN i ELSE NULL END FROM range(1, 20011) r(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 0 FROM pragma_storage_info('b_rle') WHERE column_name = 'u' AND segment_type <> 'VALIDITY' AND compression ILIKE 'rle';
----
true

statement ok
BEGIN;

# joined with blocks of a thousand ascending rows in a descending order of the blocks, the UPDATE fetches the
# previous values of u forward within a block and back from one block to the next
statement ok
UPDATE b_rle SET u = CASE WHEN src.i % 4 = 1 THEN -src.i ELSE NULL END FROM (SELECT (29 - j // 1000) * 1000 + j % 1000 + 1 AS i FROM range(0, 30000) r(j)) src WHERE b_rle.id = src.i;

statement ok
INSERT INTO b_rle SELECT i + 100000, CASE WHEN i % 4 = 1 THEN i ELSE NULL END FROM range(1, 20011) r(i);

statement ok
COMMIT;

query III
SELECT count(*), count(*) FILTER (WHERE id < 100000 AND u IS NOT DISTINCT FROM (CASE WHEN id % 4 = 1 THEN -id ELSE NULL END)), count(*) FILTER (WHERE id > 100000 AND u IS NOT DISTINCT FROM (CASE WHEN (id - 100000) % 4 = 1 THEN (id - 100000) ELSE NULL END)) FROM b_rle;
----
40020	20010	20010

