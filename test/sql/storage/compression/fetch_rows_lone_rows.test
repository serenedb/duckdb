# name: test/sql/storage/compression/fetch_rows_lone_rows.test
# description: Rows of the segments of each compression fetched alone, in clusters and at a stride
# group: [compression]

load {TEST_DIR}/test_fetch_rows_lone_rows.db readwrite serenedb_latest

statement ok
PRAGMA force_compression = 'bitpacking';

statement ok
CREATE TABLE for_wide (id INTEGER PRIMARY KEY, v BIGINT);

statement ok
INSERT INTO for_wide SELECT id, (id * 2654435761 % 1000000007) * 1000003 FROM range(1, 40001) r(id);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 0 FROM pragma_storage_info('for_wide') WHERE column_name = 'v' AND segment_type <> 'VALIDITY' AND compression ILIKE 'bitpacking';
----
true

query I
SELECT count(*) = 86 AND count(*) FILTER (WHERE v IS NOT DISTINCT FROM ((id * 2654435761 % 1000000007) * 1000003)) = 86 FROM for_wide WHERE id IN (117,349,860,1000,1001,1003,1009,1015,1016,1017,1031,1040,1901,2047,2048,2049,2050,2051,2056,2057,2062,2063,2064,2065,2078,2079,2087,2088,3399,4715,6683,7420,8191,8192,8194,8200,8206,8207,8208,8222,8231,8304,8667,9095,10280,10460,10870,10911,11933,13035,13421,13727,14122,14204,16160,16322,16341,16741,18317,18960,20000,20001,20003,20009,20015,20016,20017,20031,20040,20556,23497,24366,24954,25523,26749,29153,30516,30741,34737,35339,35636,37614,39990,39991,39993,39999);
----
true

statement ok
SET debug_force_fetch_row = true;

query I
SELECT count(*) > 0 AND count(*) = count(*) FILTER (WHERE v IS NOT DISTINCT FROM ((id * 2654435761 % 1000000007) * 1000003)) FROM for_wide WHERE id % 37 = 0;
----
true

query I
SELECT count(*) > 0 AND count(*) = count(*) FILTER (WHERE v IS NOT DISTINCT FROM ((id * 2654435761 % 1000000007) * 1000003)) FROM for_wide WHERE id % 3 <> 0;
----
true

query I
SELECT count(*) > 0 AND count(*) = count(*) FILTER (WHERE v IS NOT DISTINCT FROM ((id * 2654435761 % 1000000007) * 1000003)) FROM for_wide WHERE hash(id) % 101 = 0;
----
true

statement ok
RESET debug_force_fetch_row;

statement ok
PRAGMA force_compression = 'bitpacking';

statement ok
