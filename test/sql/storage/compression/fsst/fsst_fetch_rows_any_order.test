# name: test/sql/storage/compression/fsst/fsst_fetch_rows_any_order.test
# description: Rows of FSST segments fetched by row id, in any order and across segments
# group: [fsst]

require no_latest_storage

load {TEST_DIR}/test_fsst_fetch_rows_any_order.db readwrite v1.0.0

statement ok
PRAGMA force_compression = 'fsst';

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO t SELECT i, 'string number ' || i || ' with some text to compress' FROM range(1, 50001) r(i);

statement ok
CHECKPOINT

query I
SELECT count(*) > 1 FROM pragma_storage_info('t') WHERE segment_type = 'VARCHAR' AND compression = 'FSST';
----
true

# the index scan fetches the rows it finds by row id
query II
SELECT id, s FROM t WHERE id IN (49999, 3, 25000, 1, 50000, 7777) ORDER BY id;
----
1	string number 1 with some text to compress
3	string number 3 with some text to compress
7777	string number 7777 with some text to compress
25000	string number 25000 with some text to compress
49999	string number 49999 with some text to compress
50000	string number 50000 with some text to compress

statement ok
BEGIN

# joined with a larger source in descending order, the UPDATE of every tenth row fetches the previous values of s of
# the rows it updates in a descending row id order
statement ok
UPDATE t SET s = 'new ' || t.id FROM (SELECT i FROM range(600000, 0, -10) r(i)) src WHERE t.id = src.i;

# the rollback restores the previous values that the UPDATE fetched
statement ok
ROLLBACK

query II
SELECT count(*), count(*) FILTER (WHERE s = 'string number ' || id || ' with some text to compress') FROM t;
----
50000	50000

statement ok
UPDATE t SET s = 'new ' || t.id FROM (SELECT i FROM range(600000, 0, -10) r(i)) src WHERE t.id = src.i;

query II
SELECT count(*) FILTER (WHERE id % 10 = 0 AND s = 'new ' || id), count(*) FILTER (WHERE id % 10 <> 0 AND s = 'string number ' || id || ' with some text to compress') FROM t;
----
5000	45000
