# name: test/sql/storage/compression/fsst/fsst_fetch_rows_any_order.test
# description: Rows of FSST segments fetched by row id, in any order and across segments
# group: [fsst]

require no_latest_storage

load {TEST_DIR}/test_fsst_fetch_rows_any_order.db readwrite v1.0.0

statement ok
PRAGMA force_compression = 'fsst';

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, s VARCHAR UNIQUE, v INTEGER);

statement ok
INSERT INTO t SELECT i, 'string number ' || i || ' with some text to compress', 0 FROM range(1, 50001) r(i);

statement ok
CHECKPOINT

query I
SELECT count(*) > 1 FROM pragma_storage_info('t') WHERE segment_type = 'VARCHAR' AND compression = 'FSST';
----
true

query II
SELECT id, s FROM t WHERE id IN (49999, 3, 25000, 1, 50000, 7777) ORDER BY id;
----
1	string number 1 with some text to compress
3	string number 3 with some text to compress
7777	string number 7777 with some text to compress
25000	string number 25000 with some text to compress
49999	string number 49999 with some text to compress
50000	string number 50000 with some text to compress

# the UPDATE compares the unique column it sets with the stored values, fetched in the order of the join
statement ok
UPDATE t SET s = CASE WHEN t.id % 3 = 0 THEN t.s || '!' ELSE t.s END, v = src.id
FROM (SELECT i AS id FROM range(50000, 0, -1) r(i)) src WHERE t.id = src.id;

query II
SELECT count(*), count(*) FILTER (WHERE s = 'string number ' || id || ' with some text to compress' || CASE WHEN id % 3 = 0 THEN '!' ELSE '' END AND v = id) FROM t;
----
50000	50000

query II rowsort
DELETE FROM t WHERE id IN (49998, 2, 25001) RETURNING id, s;
----
2	string number 2 with some text to compress
25001	string number 25001 with some text to compress
49998	string number 49998 with some text to compress!
