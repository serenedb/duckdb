# name: test/sql/storage/concurrent_wal/concurrent_commit_read_own_write.test_slow
# description: A commit is visible to its committer's next statement while other commits share its WAL sync
# group: [concurrent_wal]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

foreach sleep_ms 0 2

statement ok
SET debug_wal_fsync_sleep_ms={sleep_ms}

statement ok
ATTACH '{TEST_DIR}/concurrent_commit_read_own_write{sleep_ms}.db' AS db

statement ok
CREATE TABLE db.integers(i INTEGER)

concurrentloop threadid 0 16

loop x 0 50

statement ok
INSERT INTO db.integers VALUES ({threadid} * 1000 + {x})

query I
SELECT COUNT(*) FROM db.integers WHERE i = {threadid} * 1000 + {x}
----
1

endloop

endloop

query I
SELECT COUNT(*) FROM db.integers
----
800

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_commit_read_own_write{sleep_ms}.db' AS db

query I
SELECT COUNT(*) FROM db.integers
----
800

statement ok
DETACH db

endloop
