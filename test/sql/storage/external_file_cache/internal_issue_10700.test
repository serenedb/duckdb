# name: test/sql/storage/external_file_cache/internal_issue_10700.test
# description: Internal issue 10700 - Spilled external file cache blocks are read back after the memory limit shrinks
# group: [external_file_cache]

require parquet

require httpfs

require skip_reload

statement ok
SET external_file_cache_spill_path='{TEST_DIR}/internal_issue_10700.spill';

statement ok
SET external_file_cache_spill_size='1GB';

statement ok
SET memory_limit='200MB';

statement ok
SET temp_directory='{TEST_DIR}/internal_issue_10700';

query I
SELECT count(*)
FROM read_parquet('https://github.com/duckdb/duckdb-data/releases/download/v1.0/city_temperature.parquet');
----
2905886

statement ok
SET memory_limit='1MB';

statement ok
SET memory_limit='200MB';

query I
SELECT count(*)
FROM read_parquet('https://github.com/duckdb/duckdb-data/releases/download/v1.0/city_temperature.parquet');
----
2905886

# Destroy the database while the reloaded cache blocks are still present.
restart
