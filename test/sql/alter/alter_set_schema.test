statement ok
ALTER TYPE s1.mood SET SCHEMA s2

statement ok
ALTER MACRO s1.m SET SCHEMA s2

statement ok
ALTER MACRO TABLE s1.tm SET SCHEMA s2

statement ok
ALTER FUNCTION s1.f SET SCHEMA s2

statement ok
ALTER PROCEDURE s1.p SET SCHEMA s2

query IIIIII
SELECT (SELECT count(*) FROM s2.t), (SELECT x FROM s2.v), nextval('s2.q'), s2.m(1), s2.f(2), s2.p(5)
