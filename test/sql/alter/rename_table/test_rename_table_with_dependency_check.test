# name: test/sql/alter/rename_table/test_rename_table_with_dependency_check.test
# description: Test RENAME TABLE with dependency check
# group: [rename_table]

statement ok
ATTACH '{TEST_DIR}/rename_table_dependency.db' AS db;

statement ok
CREATE TABLE db.t0 (c0 INT);

statement ok
CREATE UNIQUE INDEX i1 ON db.t0 (c0);

statement ok
INSERT INTO db.t0 VALUES (1);

# an index over the table does not block renaming it: the index follows the table
statement ok
ALTER TABLE db.t0 RENAME TO t3;

query II
SELECT index_name, table_name FROM duckdb_indexes() WHERE database_name='db';
----
i1	t3

# renaming onto a name that is taken still fails
statement ok
CREATE TABLE db.t4 (c0 INT);

statement error
ALTER TABLE db.t3 RENAME TO t4;
----
another entry with this name already exists

# the index is still the table's, across a reload
statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/rename_table_dependency.db' AS db;

statement error
INSERT INTO db.t3 VALUES (1);
----
violates unique constraint

statement ok
DROP TABLE db.t3;

statement error
ANALYZE db.t3;
----
Table with name t3 does not exist!
