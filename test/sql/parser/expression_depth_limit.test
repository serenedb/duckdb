# name: test/sql/parser/expression_depth_limit.test
# description: Test that an expression nested deeper than the stack fails cleanly
# group: [parser]

statement ok
SELECT (1+(1+(1+(1+(1+(1+(1+1)))))));

statement error
FROM query('SELECT ' || repeat('(1+', 300000) || '1' || repeat(')', 300000))
