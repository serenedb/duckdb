# name: test/sql/variant/variant_extremes.test
# description: Ordering functions and aggregates compare VARIANT values by their logical value
# group: [variant]

statement ok
CREATE TABLE nums AS SELECT * FROM (VALUES
	(1, 2::INTEGER::VARIANT),
	(2, (-7)::TINYINT::VARIANT),
	(3, 1000000::BIGINT::VARIANT),
	(4, 0.001::DECIMAL(4,3)::VARIANT),
	(5, (-3.25)::DECIMAL(4,2)::VARIANT),
	(6, 15::UTINYINT::VARIANT)
) t(id, v);

query I
SELECT list(id ORDER BY v) FROM nums
----
[2, 5, 4, 1, 6, 3]

query II
SELECT min(v), max(v) FROM nums
----
-7	1000000

query II
SELECT arg_min(id, v), arg_max(id, v) FROM nums
----
2	3

query II
SELECT max(v, 2), arg_max(id, v, 2) FROM nums
----
[1000000, 15]	[3, 6]

query II
SELECT least(2::INTEGER::VARIANT, (-7)::TINYINT::VARIANT), greatest(2::INTEGER::VARIANT, 15::UTINYINT::VARIANT)
----
-7	15

query II
SELECT list_min(list(v)), list_max(list(v)) FROM nums
----
-7	1000000

query II
SELECT 0::INTEGER::VARIANT < ALL (SELECT v FROM nums WHERE id IN (1, 3)), (-5)::INTEGER::VARIANT > ANY (SELECT v FROM nums)
----
true	true

query I
SELECT least(1::INTEGER::VARIANT, 1.00::DECIMAL(3,2)::VARIANT)
----
1

query I
SELECT greatest(1000000::BIGINT::VARIANT, 'a'::VARCHAR::VARIANT)
----
a
