# name: test/sql/catalog/function/test_sql_function_returns_type.test
# description: A SQL function returns its RETURNS type, reached from its body by a cast
# group: [function]

statement ok
CREATE FUNCTION widened() RETURNS BIGINT LANGUAGE sql RETURN 1;

query T
SELECT typeof(widened());
----
BIGINT

statement ok
CREATE FUNCTION as_text() RETURNS VARCHAR LANGUAGE sql RETURN 42;

query T
SELECT as_text();
----
42

statement ok
CREATE FUNCTION rounded() RETURNS INTEGER LANGUAGE sql RETURN 4.7;

query I
SELECT rounded();
----
5

statement ok
CREATE FUNCTION to_bool() RETURNS BOOLEAN LANGUAGE sql RETURN 1;

query I
SELECT to_bool();
----
true

statement error
CREATE FUNCTION renamed_fields() RETURNS STRUCT(a INTEGER) LANGUAGE sql AS 'SELECT {''b'': 1}';
----
STRUCT to STRUCT cast must have at least one matching member

statement ok
CREATE FUNCTION pair() RETURNS TABLE(a BIGINT, b VARCHAR) LANGUAGE sql AS 'SELECT 1, 42';

query TT
SELECT typeof(a), b FROM pair();
----
BIGINT	42

statement ok
CREATE FUNCTION numbers() RETURNS SETOF BIGINT LANGUAGE sql AS 'SELECT 1 UNION ALL SELECT 2';

query TI
SELECT typeof(numbers), numbers FROM numbers() ORDER BY 2;
----
BIGINT	1
BIGINT	2

query T
SELECT typeof(n) FROM widened() AS t(n);
----
BIGINT

statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok');

statement ok
CREATE FUNCTION moods(mood) RETURNS SETOF mood LANGUAGE sql AS 'SELECT $1';

query T
SELECT * FROM moods('ok'::mood);
----
ok

statement ok
CREATE FUNCTION as_text_list() RETURNS VARCHAR[] LANGUAGE sql AS 'SELECT [1, 2]';

query T
SELECT as_text_list();
----
[1, 2]

statement ok
CREATE FUNCTION rounded_list() RETURNS INTEGER[] LANGUAGE sql AS 'SELECT [1.6]';

query T
SELECT rounded_list();
----
[2]

statement ok
CREATE FUNCTION time_as_interval() RETURNS INTERVAL LANGUAGE sql AS 'SELECT TIME ''01:02:03''';

query T
SELECT time_as_interval();
----
01:02:03

statement ok
CREATE FUNCTION in_seconds() RETURNS TIMESTAMP_S LANGUAGE sql AS 'SELECT TIMESTAMP ''2024-01-01 10:00:00''';

query T
SELECT in_seconds();
----
2024-01-01 10:00:00

statement ok
CREATE FUNCTION pair_of(x INTEGER, OUT b BIGINT, OUT c VARCHAR) LANGUAGE sql RETURN (x, x);

query IT
SELECT * FROM pair_of(3);
----
3	3

