# name: test/sql/catalog/function/test_sql_function_returns_type.test
# description: A SQL function returns its RETURNS type, reached from its body by an assignment cast
# group: [function]

statement ok
CREATE FUNCTION widened() RETURNS BIGINT LANGUAGE sql RETURN 1;

query T
SELECT typeof(widened());
----
BIGINT

statement ok
CREATE FUNCTION as_text() RETURNS VARCHAR LANGUAGE sql RETURN 42;

query T
SELECT as_text();
----
42

statement ok
CREATE FUNCTION rounded() RETURNS INTEGER LANGUAGE sql RETURN 4.7;

query I
SELECT rounded();
----
5

statement error
CREATE FUNCTION to_bool() RETURNS BOOLEAN LANGUAGE sql RETURN 1;
----
return type mismatch in function declared to return boolean

statement ok
CREATE FUNCTION pair() RETURNS TABLE(a BIGINT, b VARCHAR) LANGUAGE sql AS 'SELECT 1, 42';

query TT
SELECT typeof(a), b FROM pair();
----
BIGINT	42

statement ok
CREATE FUNCTION numbers() RETURNS SETOF BIGINT LANGUAGE sql AS 'SELECT 1 UNION ALL SELECT 2';

query TI
SELECT typeof(numbers), numbers FROM numbers() ORDER BY 2;
----
BIGINT	1
BIGINT	2

query T
SELECT typeof(n) FROM widened() AS t(n);
----
BIGINT

statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok');

statement ok
CREATE FUNCTION moods(mood) RETURNS SETOF mood LANGUAGE sql AS 'SELECT $1';

query T
SELECT * FROM moods('ok');
----
ok
