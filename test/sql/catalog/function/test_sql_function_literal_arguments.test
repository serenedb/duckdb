# name: test/sql/catalog/function/test_sql_function_literal_arguments.test
# description: A macro of a DuckDB catalog prices a literal argument with the type it binds to
# group: [function]

statement ok
CREATE MACRO pick(a) AS 'untyped', (a DATE) AS 'date';

query I
SELECT pick('2024-01-31');
----
untyped

query I
SELECT pick(DATE '2024-01-31');
----
date

statement ok
CREATE MACRO typed_next_day(d DATE) AS d + 1;

statement error
SELECT typed_next_day('2024-12-31');
----
does not support the supplied arguments

query I
SELECT typed_next_day(DATE '2024-12-31');
----
2025-01-01
