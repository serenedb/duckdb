statement ok
CREATE FUNCTION positive_only(x BIGINT) RETURNS BIGINT LANGUAGE sql AS 'SELECT x HAVING x > 0';

statement ok
CREATE FUNCTION above_count(x BIGINT) RETURNS BIGINT LANGUAGE sql AS 'SELECT x + count(*) FROM range(3) HAVING count(*) < x';

query III
SELECT i, positive_only(i - 1), above_count(i * 2) FROM range(3) t(i) ORDER BY i
