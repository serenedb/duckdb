# name: test/sql/catalog/dependencies/rename_table_column_referenced_by_index.test
# group: [dependencies]

statement ok
ATTACH '{TEST_DIR}/rename_column_referenced_by_index.db' AS db;

statement ok
create table db.tbl(a varchar);

statement ok
create index idx on db.tbl(a);

statement ok
insert into db.tbl values ('x');

# in a DuckDB file an index over the column blocks renaming it, as in DuckDB
statement error
alter table db.tbl rename a to b;
----
Cannot alter entry "tbl" because there are entries that depend on it.

query I
select sql from duckdb_indexes() where index_name='idx';
----
CREATE INDEX idx ON tbl(a);

# and it is still usable after a reload
statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/rename_column_referenced_by_index.db' AS db;

statement ok
insert into db.tbl values ('y');

query I
select a from db.tbl where a = 'x';
----
x

# in memory the index follows the column
statement ok
create table tbl(a varchar);

statement ok
create index idx on tbl(a);

statement ok
insert into tbl values ('x');

statement ok
alter table tbl rename a to b;

query I
select sql from duckdb_indexes() where index_name='idx' and database_name='memory';
----
CREATE INDEX idx ON tbl(b);

query I
select b from tbl where b = 'x';
----
x
