# name: test/sql/function/string/regex_valid_utf8.test
# description: regexp functions over multibyte and multi-line text, with patterns that end in .* or .*$
# group: [string]

statement ok
CREATE TABLE refs AS SELECT * FROM (VALUES
	(1, 'http://a.com/x'),
	(2, E'http://a.com/x\ny'),
	(3, 'https://www.пример.рф/путь/страница'),
	(4, E'https://пример.рф/строка\nещё'),
	(5, 'http://b.org/дом/'),
	(6, 'ftp://c/'),
	(7, ''),
	(8, NULL)
) t(id, s);

query ITT
SELECT id,
	regexp_extract(s, '^https?://(?:www\.)?([^/]+)/.*$', 1),
	regexp_extract(s, '^https?://(?:www\.)?([^/]+)/.*$', 1, 's')
FROM refs
ORDER BY id
----
1	a.com	a.com
2	(empty)	a.com
3	пример.рф	пример.рф
4	(empty)	пример.рф
5	b.org	b.org
6	(empty)	(empty)
7	(empty)	(empty)
8	NULL	NULL

query I
SELECT count(*) FROM refs
WHERE regexp_extract(s, '^https?://(?:www\.)?([^/]+)/.*$', 0)
	IS DISTINCT FROM regexp_extract(s, '^(https?://(?:www\.)?[^/]+/.*)$', 1)
----
0

query IT
SELECT id, regexp_extract(s, '//([^/]+)/.*', 0) FROM refs WHERE id IN (2, 3, 4) ORDER BY id
----
2	//a.com/x
3	//www.пример.рф/путь/страница
4	//пример.рф/строка

query IT
SELECT id, regexp_replace(s, '^https?://(?:www\.)?([^/]+)/.*$', '\1') FROM refs WHERE id IN (1, 3, 5, 6) ORDER BY id
----
1	a.com
3	пример.рф
5	b.org
6	ftp://c/

query IT
SELECT id, regexp_extract_all(s, '/([^/]+)/.*', 1) FROM refs WHERE id IN (3, 5) ORDER BY id
----
3	[www.пример.рф]
5	[b.org]

query ITT
SELECT id, regexp_full_match(s, 'http.*рф.*'), regexp_full_match(s, 'http.*рф.*', 's') FROM refs WHERE id IN (1, 3, 4) ORDER BY id
----
1	false	false
3	true	true
4	false	true

query T
SELECT string_split_regex('дом1кот2сад', '[0-9]')
----
[дом, кот, сад]
