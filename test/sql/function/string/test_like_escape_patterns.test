SELECT 18, count(*) FILTER (WHERE s LIKE 'a$_b%%' ESCAPE '$') FROM strs UNION ALL
SELECT 19, count(*) FILTER (WHERE s LIKE '%a\b' ESCAPE '') FROM strs UNION ALL
SELECT 20, count(*) FILTER (WHERE s LIKE '%%50#%%%' ESCAPE '#') FROM strs UNION ALL
SELECT 21, count(*) FILTER (WHERE s LIKE 'a%b' ESCAPE '') FROM strs UNION ALL
SELECT 22, count(*) FILTER (WHERE s LIKE '#%#_' ESCAPE '#') FROM strs UNION ALL
SELECT 23, count(*) FILTER (WHERE s LIKE '##' ESCAPE '#') FROM strs UNION ALL
