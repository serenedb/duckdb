query IIII
SELECT count(*) FILTER (WHERE pushed.c IS DISTINCT FROM matched.c), count(*) FILTER (WHERE filtered.c IS DISTINCT FROM matched.c), count(*), count(*) FILTER (WHERE matched.c > 0) FROM pushed FULL OUTER JOIN filtered USING (id) FULL OUTER JOIN matched USING (id)
----
0	0	32	32

query IIIIIII
SELECT count(*) FILTER (WHERE s LIKE 'a\%b'), count(*) FILTER (WHERE s LIKE 'a\_b%'), count(*) FILTER (WHERE s LIKE '%50\%%'), count(*) FILTER (WHERE s LIKE 'a#%b' ESCAPE '#'), count(*) FILTER (WHERE s LIKE 'a__' ESCAPE '_'), count(*) FILTER (WHERE s GLOB 'a\*b\?*'), count(*) FILTER (WHERE s LIKE '\a\b') FROM strs
----
1	3	3	1	1	1	1
