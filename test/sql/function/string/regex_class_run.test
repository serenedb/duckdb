# name: test/sql/function/string/regex_class_run.test
# description: regexp_extract_all and global regexp_replace over a single repeated ASCII class agree with the same pattern inside a capture group
# group: [string]

statement ok
CREATE TABLE t AS SELECT i, CASE i % 7
    WHEN 0 THEN 'http://site' || i::VARCHAR || '.ru/a/' || (i * 7)::VARCHAR || '?x=' || (i % 13)::VARCHAR
    WHEN 1 THEN 'no digits here at all'
    WHEN 2 THEN ''
    WHEN 3 THEN 'Привет 123 мир 45 ёж KkSsſ' || chr(8490)
    WHEN 4 THEN 'aaaAAA' || i::VARCHAR || 'bab  ' || chr(9) || 'ccc'
    WHEN 5 THEN '123'
    ELSE NULL END AS s FROM range(2100) r(i);

query I
SELECT count(*) FROM t WHERE regexp_extract_all(s, '[0-9]+') IS DISTINCT FROM regexp_extract_all(s, '([0-9]+)')
   OR regexp_replace(s, '[0-9]+', '<>', 'g') IS DISTINCT FROM regexp_replace(s, '([0-9]+)', '<>', 'g');
----
0

query I
SELECT count(*) FROM t WHERE regexp_extract_all(s, '\d+') IS DISTINCT FROM regexp_extract_all(s, '(\d+)')
   OR regexp_replace(s, '\d+', '<>', 'g') IS DISTINCT FROM regexp_replace(s, '(\d+)', '<>', 'g');
----
0

