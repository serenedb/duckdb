query II
SELECT regexp_extract_all('a1b22c333', '[0-9]+'), regexp_replace('a1b22c333', '[0-9]+', 'N', 'g');
----
[1, 22, 333]	aNbNcN

query II
SELECT regexp_extract_all('abc', '[0-9]+'), regexp_replace('abc', '[0-9]+', 'N', 'g');
----
[]	abc

statement error
SELECT regexp_extract_all('a1b22', '[0-9]+', 1);
