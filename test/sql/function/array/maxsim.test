# name: test/sql/function/array/maxsim.test
# group: [array]

foreach type FLOAT DOUBLE

query I
SELECT maxsim([[1, 0], [0, 1]]::{type}[2][], [[1, 1], [2, 0]]::{type}[2][]);
----
3.0

statement ok
CREATE OR REPLACE TABLE docs (id INTEGER, v {type}[2][]);

statement ok
INSERT INTO docs VALUES (1, [[1, 0], [0, 1]]), (2, [[3, 3]]), (3, []), (4, NULL), (5, [[-1, -1], [0, 0]]);

query II
SELECT id, maxsim(v, [[1, 1], [2, 0]]::{type}[2][]) FROM docs ORDER BY id;
----
1	3.0
2	12.0
3	NULL
4	NULL
5	0.0

query I
SELECT maxsim([[1, 0]]::{type}[2][], []::{type}[2][]);
----
NULL

query I
SELECT maxsim([[1, 0]]::{type}[2][], NULL::{type}[2][]);
----
NULL

statement ok
PREPARE q AS SELECT id FROM docs ORDER BY maxsim(v, $1) DESC NULLS LAST, id LIMIT 2;

query I
EXECUTE q([[1, 1], [2, 0]]::{type}[2][]);
----
2
1

query I
EXECUTE q([[1, 1], [2, 0]]);
----
2
1

statement ok
DEALLOCATE q;

query I
SELECT maxsim(v, [[1, 1], [2, 0]]) FROM docs WHERE id = 2;
----
12.0

query I
SELECT maxsim([[1, 1], [2, 0]], v) FROM docs WHERE id = 2;
----
6.0

query I
SELECT maxsim(v, NULL) FROM docs WHERE id = 2;
----
NULL

query I
SELECT maxsim(v, []) FROM docs WHERE id = 2;
----
NULL

endloop

query I
SELECT maxsim([[1, 0]]::FLOAT[2][], [[0.5, 0.25]]::DOUBLE[2][]);
----
0.5

query I
SELECT maxsim([[1, 0]]::FLOAT[2][], [[0.5, 0.25]]);
----
0.5

query II
SELECT typeof(maxsim([[1, 0]]::FLOAT[2][], [[1, 0]])), typeof(maxsim([[1, 0]]::DOUBLE[2][], [[1, 0]]));
----
FLOAT	DOUBLE

statement error
SELECT maxsim([[1, 0]], [[1, 0]]);
----
maxsim: Arguments must be lists of arrays of FLOAT or DOUBLE

statement error
SELECT maxsim([[1, 0]]::FLOAT[2][], [[1, 0, 0]]);
----
Conversion Error

statement error
SELECT maxsim([1, 0]::FLOAT[2], [[1, 0]]::FLOAT[2][]);
----
maxsim: Arguments must be lists of arrays of FLOAT or DOUBLE

statement error
SELECT maxsim([[1, NULL]]::FLOAT[2][], [[1, 1]]::FLOAT[2][]);
----
maxsim: left argument can not contain NULL values

statement error
SELECT maxsim([NULL, [1, 0]]::FLOAT[2][], [[1, 1]]::FLOAT[2][]);
----
maxsim: left argument can not contain NULL values

statement error
SELECT maxsim([[1, 0]]::FLOAT[2][], [[1, 1], NULL]::FLOAT[2][]);
----
maxsim: right argument can not contain NULL values

statement error
SELECT maxsim([[1, 0]]::FLOAT[2][], [[1, 0, 0]]::FLOAT[3][]);
----
maxsim: Array arguments must be of the same size

statement error
SELECT maxsim([[1, 0]]::INTEGER[2][], [[1, 0]]::INTEGER[2][]);
----
maxsim: Arguments must be lists of arrays of FLOAT or DOUBLE
