# name: test/sql/function/list/list_distinct_strings.test
# description: list_distinct on VARCHAR lists keeps each distinct non-NULL string once, for short and long lists
# group: [list]

statement ok
CREATE TABLE t AS SELECT i, CASE WHEN i % 17 = 0 THEN NULL ELSE
    list_transform(range((i % 50)::BIGINT), lambda x: CASE WHEN x % 7 = 3 THEN NULL ELSE 'w' || (x % ((i % 9) + 1))::VARCHAR || CASE WHEN x % 2 = 0 THEN 'ж' ELSE '' END END) END AS l
FROM range(1000) r(i);

query I
SELECT count(*) FROM t WHERE list_sort(list_distinct(l)) IS DISTINCT FROM (SELECT list_sort(list(DISTINCT e)) FROM unnest(l) u(e) WHERE e IS NOT NULL)
  AND l IS NOT NULL AND len(list_filter(l, lambda x: x IS NOT NULL)) > 0;
----
0

query I
SELECT count(*) FROM t WHERE l IS NULL AND list_distinct(l) IS NOT NULL;
----
0

query IIII
SELECT list_distinct(['b', 'a', 'b', NULL, 'a', 'c']), list_distinct([]::VARCHAR[]), list_distinct([NULL::VARCHAR]), list_distinct(NULL::VARCHAR[]);
----
[b, a, c]	[]	[]	NULL

query I
SELECT len(list_distinct(list_transform(range(1000), lambda x: (x % 100)::VARCHAR)));
----
100

query I
SELECT list_sort(list_distinct(string_split('a/b//a/c/b', '/')));
----
['', a, b, c]
