# name: test/sql/function/list/list_sort_keys.test
# description: list_sort and list_grade_up over many lists, collations and ties
# group: [list]

query IIII
SELECT sum(len(list_sort(l))), max(list_sort(l)), max(list_sort(l, 'DESC', 'NULLS FIRST')), sum(list_sum(list_grade_up(l)))
FROM (SELECT [i % 7, (i * 13) % 11, NULL, i % 3] AS l FROM range(5000) t(i))
----
20000	[2, 6, 10, NULL]	[NULL, 10, 6, 2]	50000

statement ok
SET default_collation = 'nocase'

query III
SELECT list_sort(['b', 'A', 'a', 'B', NULL]), list_grade_up(['b', 'A', 'a', 'B']), list_reverse_sort(['b', 'A', 'a', 'B'])
----
[A, a, b, B, NULL]	[2, 3, 1, 4]	[b, B, A, a]

statement ok
RESET default_collation

query II
SELECT list_sort(['b', 'A', 'a', 'B', NULL]), list_grade_up(['b', 'A', 'a', 'B'])
----
[A, B, a, b, NULL]	[2, 4, 3, 1]

query II
SELECT list_sort(l), list_grade_up(l, 'DESC') FROM (VALUES (1, [3, NULL, 1, 2, 1]), (2, NULL), (3, [])) t(i, l) ORDER BY i
----
[1, 1, 2, 3, NULL]	[1, 4, 3, 5, 2]
NULL	NULL
[]	[]

query I
SELECT list_sort([repeat('x', 20) || '2', repeat('x', 20) || '1', 'short'])
----
[short, xxxxxxxxxxxxxxxxxxxx1, xxxxxxxxxxxxxxxxxxxx2]

query III
SELECT list_sort(l) = range(1, 1001), list_reverse_sort(l)[1:3], list_grade_up(l)[1:3]
FROM (SELECT range(1000, 0, -1) AS l)
----
true	[1000, 999, 998]	[1000, 999, 998]

query II
SELECT list_grade_up(l)[1:4], list_grade_up(l)[101:104] FROM (SELECT list_transform(range(300), lambda x: x % 3) AS l)
----
[1, 4, 7, 10]	[2, 5, 8, 11]

query I
SELECT list_sort(['ab', 'a', 'abc', 'b', 'a'])
----
[a, a, ab, abc, b]
