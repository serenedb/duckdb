# name: test/sql/function/list/array_length.test
# description: Test array_length function
# group: [list]

query I
SELECT length([1,2,3])
----
3

query I
SELECT length([])
----
0

query I
SELECT len(NULL)
----
NULL

query I
SELECT array_length(ARRAY[1, 2, 3], 1)
----
3

# PostgreSQL's multi-dimensional introspection: a dimension the array does not have is NULL, not an error
query I
SELECT array_length(ARRAY[1, 2, 3], 2)
----
NULL

query I
SELECT array_length(ARRAY[1, 2, 3], 0)
----
NULL

query I
SELECT len([1]) FROM range(3)
----
1
1
1

statement ok
CREATE TABLE lists AS SELECT * FROM (VALUES ([1, 2]), ([NULL]), (NULL), ([]), ([3, 4, 5, 6, 7])) tbl(l)

query I
SELECT len(l) FROM lists
----
2
1
NULL
0
5

query I
SELECT array_length(l, 1) FROM lists WHERE len(l) > 1
----
2
5

statement ok
CREATE TABLE nested AS SELECT * FROM (VALUES (1, [[1, 2], [3]]), (2, [[4, 5, 6]]), (3, [[]]), (4, NULL)) tbl(k, l)

query II
SELECT k, array_length(l, 2) FROM nested WHERE k > 1 ORDER BY k
----
2	3
3	NULL
4	NULL
