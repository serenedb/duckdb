# name: test/sql/function/generic/invoke.test
# group: [generic]

# Basic lambda invoke
query I
select invoke(lambda x: x * x, 2) as square_of_x
----
4

query I
SELECT invoke(lambda x: CASE WHEN i > 0 THEN x + x ELSE 0 END, (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM range(3) t(i) ORDER BY i
----
0
2
4

query I
SELECT invoke(lambda x: CASE WHEN i = 1 THEN x WHEN i = 2 THEN x * 10 END, (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM range(3) t(i) ORDER BY i
----
NULL
1
20

query I
SELECT invoke(lambda x: TRY(x + x), (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM range(3) t(i) ORDER BY i
----
NULL
2
4

query II
SELECT i, CASE WHEN i > 0 THEN invoke(lambda x: CASE WHEN i > 1 THEN x + x END, (CASE WHEN i < 2 THEN 'x' ELSE i::VARCHAR END)::INTEGER) END FROM range(4) t(i) ORDER BY i
----
0	NULL
1	NULL
2	4
3	6

query II
SELECT i, invoke(lambda x: COALESCE(CASE WHEN i > 0 THEN x END, 0) + x, i + 1) FROM range(3) t(i) ORDER BY i
----
0	1
1	4
2	6

query II
SELECT i, invoke(lambda x: x + x + list_sum(list_transform(l, lambda y: y * 2)), i + 1) FROM (SELECT i, [i, 1] AS l FROM range(3) t(i)) ORDER BY i
----
0	4
1	8
2	12

query II
SELECT i, invoke(lambda x: list_transform(l, lambda y: y + x)[1] + x, i + 1) FROM (SELECT i, [i] AS l FROM range(3) t(i)) ORDER BY i
----
0	2
1	5
2	8

query II
SELECT i, invoke(lambda x: list_reduce(l, lambda a, b: a + b + x) + x, i + 10) FROM (SELECT i, [i, 1] AS l FROM range(3) t(i)) ORDER BY i
----
0	21
1	24
2	27

query I
SELECT invoke(lambda x: CASE WHEN i > 0 THEN x + x ELSE list_sum(list_transform([i, 1], lambda y: y)) END, (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM range(3) t(i) ORDER BY i
----
1
2
4

query II
SELECT i, invoke(lambda x: list_sum(list_transform(l, lambda y: y + x)), (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM (SELECT i, CASE WHEN i = 0 THEN []::INTEGER[] ELSE [i] END AS l FROM range(3) t(i)) ORDER BY i
----
0	NULL
1	2
2	4

query II
SELECT i, invoke(lambda x: list_reduce(l, lambda acc, e: acc + e + x, 0), (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM (SELECT i, CASE WHEN i = 0 THEN []::INTEGER[] ELSE [i] END AS l FROM range(3) t(i)) ORDER BY i
----
0	0
1	2
2	4

query II
SELECT i, invoke(lambda x: list_sum(list_transform(l, lambda y: CASE WHEN y > 5 THEN x + x END)), (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM (SELECT i, CASE WHEN i = 0 THEN [1, 2] ELSE [i * 10] END AS l FROM range(3) t(i)) ORDER BY i
----
0	NULL
1	2
2	4

query II
SELECT i, invoke(lambda x: list_reduce(l, lambda acc, e: acc + CASE WHEN e > 5 THEN x + x ELSE 0 END, 0), (CASE WHEN i = 0 THEN 'x' ELSE i::VARCHAR END)::INTEGER) FROM (SELECT i, CASE WHEN i = 0 THEN [1, 2] ELSE [i * 10] END AS l FROM range(3) t(i)) ORDER BY i
----
0	0
1	2
2	4

statement ok
PRAGMA disable_optimizer

query II
SELECT i, invoke(lambda x: CASE WHEN i = 1 THEN x WHEN i = 2 THEN x * 10 + j END, i) FROM (SELECT i, i + 1 AS j FROM range(3) t(i)) ORDER BY i
----
0	NULL
1	1
2	23

query II
SELECT i, invoke(lambda x: COALESCE(CASE WHEN i > 0 THEN x END, 0) + x, 5) FROM range(3) t(i) ORDER BY i
----
0	5
1	10
2	10

query II
SELECT i, invoke(lambda x: COALESCE(CASE WHEN c1 THEN x END, 0) + COALESCE(CASE WHEN c2 THEN x END, 0) + CASE WHEN c3 THEN x ELSE 0 END, i * 10) FROM (VALUES (0, true, false, true), (1, false, true, true), (2, false, false, true), (3, true, false, true)) t(i, c1, c2, c3) ORDER BY i
----
0	0
1	20
2	20
3	60

query II
SELECT i, invoke(lambda x: list_sum(list_transform(range(3000 + i * 0), lambda a: a + x)), 5) FROM range(2) t(i) ORDER BY i
----
0	4513500
1	4513500

query II
SELECT i, invoke(lambda x: list_sum(list_transform(range(3000 + i * 0), lambda a: CASE WHEN a % 1000 = 999 THEN x ELSE 0 END)), i + 1) FROM range(2) t(i) ORDER BY i
----
0	3
1	6

query II
SELECT i, invoke(lambda x: list_reduce(range(3000 + i * 0), lambda acc, a: acc + CASE WHEN a % 1000 = 999 THEN x ELSE 0 END, 0), i + 1) FROM range(2) t(i) ORDER BY i
----
0	3
1	6

query II
SELECT i, invoke(lambda x: x * 0 + list_sum(list_transform(range(3000 + i * 0), lambda y: y * x)), i + 1) FROM range(3) t(i) ORDER BY i
----
0	4498500
1	8997000
2	13495500

statement ok
PRAGMA enable_optimizer

statement ok
CREATE SEQUENCE invoke_strict_seq START 1

query II
SELECT count(*), max(r) FROM (SELECT invoke(lambda x: CASE WHEN i < 0 THEN x END, nextval('invoke_strict_seq')) AS r FROM range(5) t(i))
----
5	NULL

query I
SELECT currval('invoke_strict_seq')
----
5

# Lambda volatility must be visible to common subexpression elimination.
statement ok
CREATE SEQUENCE invoke_cse_seq START 1

query II
SELECT count(*) FILTER (WHERE a = b), count(*)
FROM (
	SELECT
		invoke(lambda x: nextval('invoke_cse_seq'), i) a,
		invoke(lambda x: nextval('invoke_cse_seq'), i) b
	FROM range(10000) tbl(i)
)
----
0	10000

# Volatile lambda bodies must not be constant-folded when all invoke arguments are constant.
statement ok
CREATE SEQUENCE invoke_constant_seq START 1

query I
SELECT count(DISTINCT invoke(lambda x: nextval('invoke_constant_seq'), 1)) FROM range(10000)
----
10000

# Throwing lambda bodies must produce the original execution error.
statement error
SELECT invoke(lambda x: error('expected'), 1)
----
expected

# Only the first argument is a lambda: a lambda passed as an argument does not bind.
statement error
SELECT invoke(lambda x: x, lambda y: y)
----
<REGEX>:Binder Error.*No function matches the given name and argument types.*

# A macro parameter cannot stand in for the lambda.
statement error
CREATE MACRO invoke_parameter(f) AS invoke(f, 1)
----
<REGEX>:Binder Error.*Invalid lambda expression passed to 'invoke' function.*

# CONSISTENT_WITHIN_QUERY lambda bodies must remain inconsistent for persistent expressions.
statement ok
CREATE TABLE invoke_consistency_tbl(i INTEGER)

statement error
CREATE INDEX invoke_consistency_idx ON invoke_consistency_tbl (invoke(lambda x: current_schema(), i))
----
Index keys cannot contain expressions with side effects

# Multiple bindings using nested invoke
query I
select invoke(lambda a: invoke(lambda b: a + b, 4), 3) as sum_ab
----
7

# Multiple arguments
query I
select invoke(lambda x, y: x * y + y, 3, 4) as result
----
16

query I
select invoke(lambda x, y, z: x + y + z, 1, 2, 3) as result
----
6

query I
select invoke(lambda x, y, z: x * 100 + y * 10 + z, 1, 2, 3) as result
----
123

query I
select invoke(lambda x, y, z, w: x * y + z * w, 1, 2, 3, 4) as result
----
14

# Nested invoke expressions
query I
select invoke(lambda x: invoke(lambda y: y + 5, x + 3), 2) as result
----
10

query I
select invoke(lambda x: invoke(lambda y: y + x + 5, 3), 2) as result
----
10

# Nested multiple lambda invoke with multiple arguments
query I
select invoke(lambda a: invoke(lambda b, c: a + b + c, 4, 5), 3) as result
----
12

# Also the other way around
query I
select invoke(lambda a, b: invoke(lambda c: a + b + c, 5), 3, 4) as result
----
12

query I
select invoke(lambda a, b: invoke(lambda c: a * 100 + b * 10 + c, 3), 1, 2) as result
----
123

# Lambda invoke with row constructor
query II
SELECT unnest(invoke(lambda x: invoke(lambda y: row(x, y), 3), 2));
----
2	3

# Lambda invoke with different types
query I
SELECT invoke(lambda name: invoke(lambda age: name || age, 30), 'Alice, ');
----
Alice, 30

# Lambda invoke with nested lambda
query I
SELECT invoke(lambda x: list_transform([1,2,3], LAMBDA y: y + x), 1);
----
[2, 3, 4]

query I
SELECT invoke(lambda x: list_transform([10, 20], lambda y, i: x + y + i), 100);
----
[111, 122]

# Lambda invoke with NULL
query I
select invoke(lambda x: x IS NULL, NULL);
----
true

# Naming is correct
query I
select invoke(lambda x: alias(x), 1);
----
x

# Lambda invoke in non-SELECT context
query I rowsort
SELECT * FROM range(0, 10) as r(i) WHERE invoke(lambda x: x, i % 2 == 0) ORDER BY ALL;
----
0
2
4
6
8

# Stored invoke expressions should preserve lambda reference ordering across restarts.
load {TEST_DIR}/invoke_storage.db

statement ok
CREATE TABLE invoke_order_tbl AS SELECT 1 a, 2 b, 3 c

statement ok
CREATE VIEW invoke_order_view AS SELECT invoke(lambda x, y, z: x * 100 + y * 10 + z, a, b, c) AS result FROM invoke_order_tbl

statement ok
CREATE TABLE invoke_dictionary_tbl AS
	SELECT CASE WHEN i % 2 = 0 THEN 'x' ELSE 'y' END s FROM range(10000) tbl(i)

statement ok
CREATE SEQUENCE invoke_dictionary_seq START 1

statement ok
CREATE SEQUENCE invoke_stored_volatile_seq START 1

statement ok
CREATE VIEW invoke_stored_volatile_view AS
	SELECT
		invoke(lambda x: nextval('invoke_stored_volatile_seq'), i) a,
		invoke(lambda x: nextval('invoke_stored_volatile_seq'), i) b
	FROM range(1000) tbl(i)

statement ok
CREATE SEQUENCE invoke_stored_constant_seq START 1

statement ok
CREATE VIEW invoke_stored_constant_view AS
	SELECT invoke(lambda x: nextval('invoke_stored_constant_seq'), 1) v FROM range(10000)

statement ok
CREATE VIEW invoke_stored_error_view AS
	SELECT invoke(lambda x: error('stored expected'), 1) v

statement ok
CREATE TABLE invoke_throw_dictionary_tbl AS
	SELECT CASE WHEN i % 2 = 0 THEN '1' ELSE 'bad' END s FROM range(10000) tbl(i)

query I
SELECT result FROM invoke_order_view
----
123

restart

query I
SELECT result FROM invoke_order_view
----
123

# Volatility in deserialized lambda bind data must remain visible to the optimizer.
query II
SELECT count(*) FILTER (WHERE a = b), count(*) FROM invoke_stored_volatile_view
----
0	1000

# Deserialized volatile lambda bodies must also bypass constant-vector execution.
query I
SELECT count(DISTINCT v) FROM invoke_stored_constant_view
----
10000

# Deserialization must restore fallibility on the bound function metadata.
statement error
SELECT * FROM invoke_stored_error_view
----
<REGEX>:Invalid Input Error.*stored expected.*

# Volatile lambda bodies must execute once per row, not once per dictionary entry.
query I
SELECT count(DISTINCT invoke(lambda x: nextval('invoke_dictionary_seq'), s)) FROM invoke_dictionary_tbl
----
10000

# Dictionary evaluation must not evaluate throwing bodies for filtered-out values.
query I
SELECT sum(invoke(lambda x: x::INTEGER, s)) FROM invoke_throw_dictionary_tbl WHERE s = '1'
----
5000

# Errors
statement error
SELECT invoke(lambda x: x + x, 2, 4, 6);
----
Binder Error: The number of lambda parameters does not match the number of arguments passed to the 'invoke' function, expected 1, got 3.

statement error
SELECT invoke(lambda x, y: x + y, 2);
----
Binder Error: The number of lambda parameters does not match the number of arguments passed to the 'invoke' function, expected at least 2, got 1.

statement error
SELECT invoke(NULL, 1);
----
Binder Error: Invalid lambda expression passed to 'invoke' function.

# a runtime error thrown by the lambda body must surface as-is

statement error
SELECT invoke(lambda x: x::INTEGER, 'abc');
----
Conversion Error: Could not convert string 'abc' to INT32

statement error
SELECT invoke(lambda x: error('boom'), 1);
----
Invalid Input Error: boom

statement error
SELECT invoke(lambda x: x * 2, 9223372036854775807::BIGINT);
----
Out of Range Error: Overflow in multiplication of INT64
