# name: test/sql/function/timestamp/test_icu_cast_naive_fixed_offset.test
# description: Casts from TIMESTAMPTZ to naive timestamps and times under a fixed offset, where statistics let them shift whole vectors, give the values of the zone table, and so do the zones with transitions, a calendar without a zone table and the ranges a shift would overflow
# group: [timestamp]

require icu

statement ok
SET Calendar = 'gregorian';

statement ok
SET TimeZone = 'UTC';

statement ok
CREATE TABLE tz AS SELECT TIMESTAMPTZ '2025-09-23 00:00:00+00' + INTERVAL (i * 7) SECOND + INTERVAL (i % 1000) MICROSECOND AS t, i AS v FROM range(0, 5000) t(i);

statement ok
CREATE TABLE tzn AS SELECT make_timestamp_ns(epoch_ns(t) + v % 1000)::TIMESTAMPTZ_NS AS t, v FROM tz;

statement ok
CREATE TABLE epoch AS SELECT make_timestamp_ns(i * 37 - 1110000)::TIMESTAMPTZ_NS AS t, i AS v FROM range(0, 60000) t(i);

statement ok
CREATE TABLE epochu AS SELECT t::TIMESTAMPTZ AS t, v FROM epoch;

statement ok
CREATE TABLE edge (t TIMESTAMPTZ_NS, v INTEGER);

statement ok
INSERT INTO edge VALUES ('1969-12-31 23:59:59.9999996+00', 1), ('1969-12-31 23:59:59.9999994+00', 2), ('2025-09-23 00:00:59.9999995+00', 3), ('infinity', 4), ('-infinity', 5), (NULL, 6);

foreach zone Etc/UTC Etc/GMT-3 Asia/Kolkata Europe/Berlin

statement ok
SET TimeZone = '{zone}';

query I
SELECT count(*) FROM tz WHERE t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP OR t::TIMESTAMP_MS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_MS OR t::TIMESTAMP_S IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_S OR t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_NS OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME_NS
----
0

query I
SELECT count(*) FROM tzn WHERE t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_NS OR t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP OR t::TIMESTAMP_MS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_MS OR t::TIMESTAMP_S IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_S OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME_NS
----
0

query I
SELECT count(*) FROM epoch WHERE t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_NS OR t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP OR t::TIMESTAMP_S IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_S OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME_NS
----
0

query I
SELECT count(*) FROM epochu WHERE t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP OR t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_NS OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME_NS
----
0

query I
SELECT count(*) FROM edge WHERE t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_NS OR t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP OR TRY_CAST(t AS TIME) IS DISTINCT FROM TRY_CAST(t::VARCHAR::TIMESTAMPTZ_NS AS TIME) OR TRY_CAST(t AS TIME_NS) IS DISTINCT FROM TRY_CAST(t::VARCHAR::TIMESTAMPTZ_NS AS TIME_NS)
----
0

endloop

statement ok
SET TimeZone = 'Etc/GMT-3';

query IIII
SELECT v, t::TIMESTAMP_NS = n, t::TIMESTAMP = u, t::TIMESTAMP_S = s FROM edge JOIN (VALUES (1, TIMESTAMP_NS '1970-01-01 02:59:59.9999996', TIMESTAMP '1970-01-01 03:00:00', TIMESTAMP_S '1970-01-01 03:00:00'), (2, TIMESTAMP_NS '1970-01-01 02:59:59.9999994', TIMESTAMP '1970-01-01 02:59:59.999999', TIMESTAMP_S '1970-01-01 03:00:00'), (3, TIMESTAMP_NS '2025-09-23 03:00:59.9999995', TIMESTAMP '2025-09-23 03:01:00', TIMESTAMP_S '2025-09-23 03:01:00'), (4, TIMESTAMP_NS 'infinity', TIMESTAMP 'infinity', TIMESTAMP_S 'infinity'), (5, TIMESTAMP_NS '-infinity', TIMESTAMP '-infinity', TIMESTAMP_S '-infinity')) expected(v, n, u, s) USING (v) ORDER BY v
----
1	true	true	true
2	true	true	true
3	true	true	true
4	true	true	true
5	true	true	true

query IIIIII
SELECT min(t::TIMESTAMP), max(t::TIMESTAMP), min(t::TIMESTAMP_NS), max(t::TIMESTAMP_NS), min(t::TIME), max(t::TIME) FROM tz
----
2025-09-23 03:00:00	2025-09-23 12:43:13.000999	2025-09-23 03:00:00	2025-09-23 12:43:13.000999	03:00:00	12:43:13.000999

query II
SELECT stats(t::TIMESTAMP_NS).min, stats(t::TIMESTAMP_NS).max FROM tz LIMIT 1
----
2025-09-23 03:00:00	2025-09-23 12:43:13.000999

query IIII
SELECT min(t::TIME), max(t::TIME), min(t::TIME_NS), max(t::TIME_NS) FROM epoch
----
02:59:59.99889	03:00:00.00111	02:59:59.99889	03:00:00.001109963

statement ok
CREATE TABLE tzinf (t TIMESTAMPTZ);

statement ok
INSERT INTO tzinf VALUES ('2025-09-23 00:00:00+00'), ('infinity');

statement ok
CREATE TABLE tzneginf (t TIMESTAMPTZ);

statement ok
INSERT INTO tzneginf VALUES ('2025-09-23 00:00:00+00'), ('-infinity');

statement ok
CREATE TABLE tzninf (t TIMESTAMPTZ_NS);

statement ok
INSERT INTO tzninf VALUES ('2025-09-23 00:00:00+00'), ('infinity');

query IIII
SELECT min(t::TIMESTAMP), max(t::TIMESTAMP), min(TRY_CAST(t AS TIME)), max(TRY_CAST(t AS TIME)) FROM tzinf
----
2025-09-23 03:00:00	infinity	03:00:00	03:00:00

query IIII
SELECT min(t::TIMESTAMP), max(t::TIMESTAMP), min(TRY_CAST(t AS TIME)), max(TRY_CAST(t AS TIME)) FROM tzneginf
----
-infinity	2025-09-23 03:00:00	03:00:00	03:00:00

query IIII
SELECT min(t::TIMESTAMP_NS), max(t::TIMESTAMP_NS), min(TRY_CAST(t AS TIME_NS)), max(TRY_CAST(t AS TIME_NS)) FROM tzninf
----
2025-09-23 03:00:00	infinity	03:00:00	03:00:00

statement ok
CREATE TABLE tzfar (t TIMESTAMPTZ);

statement ok
INSERT INTO tzfar VALUES ('2025-09-23 00:00:00+00'), ('2300-01-01 00:00:00+00');

statement error
SELECT max(t::TIMESTAMP_NS) FROM tzfar
----
Could not convert Timestamp to higher precision

statement ok
CREATE TABLE tzpast (t TIMESTAMPTZ);

statement ok
INSERT INTO tzpast VALUES ('1600-01-01 00:00:00+00'), ('2025-09-23 00:00:00+00');

statement error
SELECT min(t::TIMESTAMP_NS) FROM tzpast
----
Could not convert Timestamp to higher precision

statement ok
SET Calendar = 'iso8601';

query I
SELECT count(*) FROM tz WHERE t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP OR t::TIMESTAMP_MS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_MS OR t::TIMESTAMP_S IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_S OR t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIMESTAMP_NS OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ::TIME_NS
----
0

query I
SELECT count(*) FROM tzn WHERE t::TIMESTAMP_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_NS OR t::TIMESTAMP IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP OR t::TIMESTAMP_MS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_MS OR t::TIMESTAMP_S IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIMESTAMP_S OR t::TIME IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME OR t::TIME_NS IS DISTINCT FROM t::VARCHAR::TIMESTAMPTZ_NS::TIME_NS
