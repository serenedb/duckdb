# name: test/sql/function/numeric/test_round_constant_precision.test
# description: round and round_even on FLOAT/DOUBLE with a constant precision match the per-row precision path
# group: [numeric]

statement ok
CREATE TABLE t AS SELECT (i * 0.37 - 2000.125)::DOUBLE AS d, (i * 0.37 - 2000.125)::FLOAT AS f, ((i % 9) - 4)::INTEGER AS p FROM range(20000) r(i);

statement ok
INSERT INTO t VALUES (NULL, NULL, 2), ('inf'::DOUBLE, 'inf'::FLOAT, 2), ('-inf'::DOUBLE, '-inf'::FLOAT, -2), ('nan'::DOUBLE, 'nan'::FLOAT, 1), (1e308, 3e38, 5), (2.5, 2.5, 0), (-2.5, -2.5, 0), (25, 25, -1), (35, 35, -1);

query I
SELECT count(*) FROM t WHERE (CASE p WHEN -4 THEN round(d, -4) WHEN -3 THEN round(d, -3) WHEN -2 THEN round(d, -2) WHEN -1 THEN round(d, -1) WHEN 0 THEN round(d, 0) WHEN 1 THEN round(d, 1) WHEN 2 THEN round(d, 2) WHEN 3 THEN round(d, 3) WHEN 4 THEN round(d, 4) WHEN 5 THEN round(d, 5) END) IS DISTINCT FROM round(d, p) OR (CASE p WHEN -4 THEN round(f, -4) WHEN -3 THEN round(f, -3) WHEN -2 THEN round(f, -2) WHEN -1 THEN round(f, -1) WHEN 0 THEN round(f, 0) WHEN 1 THEN round(f, 1) WHEN 2 THEN round(f, 2) WHEN 3 THEN round(f, 3) WHEN 4 THEN round(f, 4) WHEN 5 THEN round(f, 5) END) IS DISTINCT FROM round(f, p) OR (CASE p WHEN -4 THEN round_even(d, -4) WHEN -3 THEN round_even(d, -3) WHEN -2 THEN round_even(d, -2) WHEN -1 THEN round_even(d, -1) WHEN 0 THEN round_even(d, 0) WHEN 1 THEN round_even(d, 1) WHEN 2 THEN round_even(d, 2) WHEN 3 THEN round_even(d, 3) WHEN 4 THEN round_even(d, 4) WHEN 5 THEN round_even(d, 5) END) IS DISTINCT FROM round_even(d, p) OR (CASE p WHEN -4 THEN round_even(f, -4) WHEN -3 THEN round_even(f, -3) WHEN -2 THEN round_even(f, -2) WHEN -1 THEN round_even(f, -1) WHEN 0 THEN round_even(f, 0) WHEN 1 THEN round_even(f, 1) WHEN 2 THEN round_even(f, 2) WHEN 3 THEN round_even(f, 3) WHEN 4 THEN round_even(f, 4) WHEN 5 THEN round_even(f, 5) END) IS DISTINCT FROM round_even(f, p);
----
0

query IIIIII
SELECT round(2.345::DOUBLE, 2), round(-2.345::DOUBLE, 1), round(1234.5::DOUBLE, -2), round_even(2.5::DOUBLE, 0), round_even(25::DOUBLE, -1), round(1.25::FLOAT, 1);
----
2.35	-2.3	1200.0	2.0	20.0	1.3

query III
SELECT round('inf'::DOUBLE, 2), round('inf'::DOUBLE, -2), round(d, NULL) FROM t LIMIT 1;
----
inf	0.0	NULL

query I
SELECT sum(round(d / 3.0, 2)) = sum(round(d / 3.0, (p * 0 + 2)::INTEGER)) FROM t;
----
true
