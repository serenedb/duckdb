# name: test/sql/function/numeric/integer_overflow_wrap.test
# description: integer_overflow = 'wrap' makes integer +, -, * and unary minus wrap around
# group: [numeric]

statement error
SELECT 9223372036854775807::BIGINT + 1
----
Overflow in addition

statement ok
SET integer_overflow = 'wrap'

query IIIIII
SELECT 9223372036854775807::BIGINT + 1, '-9223372036854775808'::BIGINT - 1, 4294967296::BIGINT * 4294967296, 127::TINYINT + 1::TINYINT, 255::UTINYINT + 1::UTINYINT, 0::UBIGINT - 1::UBIGINT
----
-9223372036854775808	9223372036854775807	0	-128	0	18446744073709551615

query II
SELECT 170141183460469231731687303715884105727::HUGEINT + 1, 340282366920938463463374607431768211455::UHUGEINT * 2::UHUGEINT
----
-170141183460469231731687303715884105728	340282366920938463463374607431768211454

query I
SELECT -x FROM (VALUES ('-9223372036854775808'::BIGINT), (5::BIGINT), (NULL)) t(x)
----
-9223372036854775808
-5
NULL

query I
SELECT -x FROM (VALUES (1::UINTEGER)) t(x)
----
4294967295

query III
SELECT min(i * 9223372036854775807), max(i * 9223372036854775807), sum(i * 9223372036854775807) FROM range(3) t(i)
----
-2	9223372036854775807	9223372036854775805

query I
SELECT sum((i * 6364136223846793005 + 1442695040888963407) % 2147483648) FROM range(100000) t(i)
----
825339984

statement ok
RESET integer_overflow

statement error
SELECT -x FROM (VALUES ('-9223372036854775808'::BIGINT)) t(x)
----
Overflow in negation

statement error
SELECT i * 9223372036854775807 FROM range(3) t(i)
----
Overflow in multiplication
