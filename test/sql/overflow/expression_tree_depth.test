 + x FROM integers

# Deeply nested expressions must not overflow the C stack: every clause raises the stack depth limit
# instead of crashing. Using query() keeps the literal out of this file.
statement ok
CREATE TABLE deep_t(x INTEGER)

test-env DEEP_EXPRESSION_DEPTH 300000

# select list
statement error
FROM query('SELECT ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}))
----
<REGEX>:.*stack depth limit exceeded.*

# a STAR nested deep inside an expression
statement error
FROM query('SELECT ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || 'COLUMNS(*)' || repeat(')', {DEEP_EXPRESSION_DEPTH}) || ' FROM deep_t')
----
<REGEX>:.*stack depth limit exceeded.*

# WHERE
statement error
FROM query('SELECT 1 FROM deep_t WHERE ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}) || ' > 0')
----
<REGEX>:.*stack depth limit exceeded.*

# GROUP BY
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}))
----
<REGEX>:.*stack depth limit exceeded.*

# HAVING
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY x HAVING ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}) || ' > 0')
----
<REGEX>:.*stack depth limit exceeded.*

# QUALIFY
statement error
FROM query('SELECT 1 FROM deep_t QUALIFY ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}) || ' > 0')
----
<REGEX>:.*stack depth limit exceeded.*

# ORDER BY
statement error
FROM query('SELECT 1 FROM deep_t ORDER BY ' || repeat('abs(', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(')', {DEEP_EXPRESSION_DEPTH}))
----
<REGEX>:.*stack depth limit exceeded.*

# nested list form, GROUP BY [[[ ... ]]]
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY ' || repeat('[', {DEEP_EXPRESSION_DEPTH}) || '1' || repeat(']', {DEEP_EXPRESSION_DEPTH}))
----
<REGEX>:.*stack depth limit exceeded.*

# CREATE statements store a query/expression that later passes (dependency extraction, copy,
# serialization) walk recursively; a moderate depth goes through each statement type.
statement ok
CREATE TABLE idx_t(x INTEGER)

