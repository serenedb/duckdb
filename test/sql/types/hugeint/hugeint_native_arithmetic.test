----
Overflow in subtraction

statement error
SELECT 340282366920938463426481119284349108224::UHUGEINT - 340282366920938463444927863358058659841::UHUGEINT
----
Overflow in subtraction

statement error
SELECT 18446744073709551616::UHUGEINT * 18446744073709551616
----
Overflow in multiplication

query II
SELECT sum(i::HUGEINT * 1103515245 % 2147483648), sum((i::HUGEINT - 50000) * 170141183460469231731 // 98765432109876543210) FROM range(100000) t(i)
----
107371037622512	-86133

query IIII
SELECT 340282366920938463463374607431768211455::UHUGEINT % 18446744073709551616::UHUGEINT, 340282366920938463463374607431768211455::UHUGEINT // 18446744073709551616::UHUGEINT, 170141183460469231731687303715884105728::UHUGEINT // 1267650600228229401496703205376::UHUGEINT, 170141183460469231731687303715884105733::UHUGEINT % 1267650600228229401496703205376::UHUGEINT
