# name: test/sql/types/hugeint/hugeint_native_arithmetic.test
# description: HUGEINT and UHUGEINT division, shifts and overflow checks at their boundaries
# group: [hugeint]

query IIII
SELECT (-7)::HUGEINT % 3, 7::HUGEINT % (-3), (-7)::HUGEINT // 2, 7::HUGEINT // (-2)
----
-1	1	-3	-3

query IIII
SELECT 12345678901234567890123456789::HUGEINT // 987654321, 12345678901234567890123456789::HUGEINT % 987654321, (-12345678901234567890123456789)::HUGEINT // 987654321098765432109, (-12345678901234567890123456789)::HUGEINT % 987654321098765432109
----
12499999887343749990	156249999	-12499999	-875154321087526388898

query II
SELECT (-170141183460469231731687303715884105728)::HUGEINT // 7, (-170141183460469231731687303715884105728)::HUGEINT % 7
----
-24305883351495604533098186245126300818	-2

query II
SELECT 340282366920938463463374607431768211455::UHUGEINT // 7, 340282366920938463463374607431768211455::UHUGEINT % 7
----
48611766702991209066196372490252601636	3

statement error
SELECT (-170141183460469231731687303715884105728)::HUGEINT // -1
----
Overflow in division

statement error
SELECT 1::HUGEINT // 0
----
Division by zero

statement error
SELECT 5::UHUGEINT % 0
----
Division by zero

query III
SELECT (-1)::HUGEINT >> 200, (-8)::HUGEINT >> 1, (-170141183460469231731687303715884105728)::HUGEINT >> 127
----
0	-4	-1

query IIII
SELECT 1::HUGEINT << 126, 1::HUGEINT << 64, 3::HUGEINT << 63, 5::HUGEINT << 0
----
85070591730234615865843651857942052864	18446744073709551616	27670116110564327424	5

query III
SELECT 1::UHUGEINT << 127, 340282366920938463463374607431768211455::UHUGEINT >> 64, 340282366920938463463374607431768211455::UHUGEINT >> 127
----
170141183460469231731687303715884105728	18446744073709551615	1

statement error
SELECT 170141183460469231731687303715884105727::HUGEINT + 1
----
Overflow in addition

statement error
SELECT (-170141183460469231731687303715884105728)::HUGEINT - 1
----
Overflow in subtraction

query I
