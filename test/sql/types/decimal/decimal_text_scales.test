# name: test/sql/types/decimal/decimal_text_scales.test
# description: DECIMAL to VARCHAR writes every fraction digit, at odd and even scales of 16, 32 and 64-bit decimals
# group: [decimal]

query IIIIII
SELECT '-0.05'::DECIMAL(4,2)::VARCHAR, '9.999'::DECIMAL(4,3)::VARCHAR, '-0.0001'::DECIMAL(4,4)::VARCHAR, '-9999'::DECIMAL(4,0)::VARCHAR, '0.5'::DECIMAL(4,1)::VARCHAR, '-12.3'::DECIMAL(4,1)::VARCHAR;
----
-0.05	9.999	-0.0001	-9999	0.5	-12.3

query IIIIII
SELECT '0.000000001'::DECIMAL(9,9)::VARCHAR, '-0.99999999'::DECIMAL(9,8)::VARCHAR, '1234.56789'::DECIMAL(9,5)::VARCHAR, '-1234567.8'::DECIMAL(9,1)::VARCHAR, '100.00'::DECIMAL(9,2)::VARCHAR, '-0.010'::DECIMAL(9,3)::VARCHAR;
----
0.000000001	-0.99999999	1234.56789	-1234567.8	100.00	-0.010

query IIIIII
SELECT '-0.999999999999999999'::DECIMAL(18,18)::VARCHAR, '0.00000000000000001'::DECIMAL(18,17)::VARCHAR, '123456789012.345678'::DECIMAL(18,6)::VARCHAR, '-99999999999999999.9'::DECIMAL(18,1)::VARCHAR, '-999999999999999999'::DECIMAL(18,0)::VARCHAR, '12345.0000000'::DECIMAL(18,7)::VARCHAR;
----
-0.999999999999999999	0.00000000000000001	123456789012.345678	-99999999999999999.9	-999999999999999999	12345.0000000
