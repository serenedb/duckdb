# name: test/sql/row_security/row_security_policies.test
# group: [row_security]

statement ok
CREATE TABLE squad (id INTEGER, member VARCHAR, grade INTEGER, note VARCHAR);

statement ok
INSERT INTO squad VALUES (1, 'arelav', 42, 'skuf'), (2, 'babsky', 21, 'boss'), (3, 'arelav', 13, '7');

statement ok
ALTER TABLE squad ENABLE ROW LEVEL SECURITY;

query I
SELECT count(*) FROM squad;
----
3

statement ok
ALTER TABLE squad FORCE ROW LEVEL SECURITY;

query I
SELECT count(*) FROM squad;
----
0

statement ok
CREATE POLICY arelav_rows ON squad USING (member = 'arelav');

query II
SELECT id, note FROM squad ORDER BY id;
----
1	skuf
3	7

statement error
CREATE POLICY arelav_rows ON squad USING (true);
----
<REGEX>:.*policy "arelav_rows" for table "squad" already exists.*

statement error
CREATE POLICY vedernikoff_rows ON squad TO vedernikoff USING (true);
----
<REGEX>:.*role "vedernikoff" does not exist.*

statement error
CREATE POLICY inserts ON squad FOR INSERT USING (true);
----
<REGEX>:.*only WITH CHECK expression allowed for INSERT.*

statement error
CREATE POLICY selects ON squad FOR SELECT WITH CHECK (true);
----
<REGEX>:.*WITH CHECK cannot be applied to SELECT or DELETE.*

statement error
CREATE POLICY unknown_column ON squad USING (nope = 1);
----
<REGEX>:.*nope.*

statement ok
CREATE POLICY skuf_only ON squad AS RESTRICTIVE FOR SELECT USING (grade > 20);

query IIIIII
SELECT policy_name, relation_name, relation_type, permissive, command, using_expression FROM duckdb_policies() ORDER BY policy_name;
----
arelav_rows	squad	TABLE	true	ALL	(member = 'arelav')
skuf_only	squad	TABLE	false	SELECT	(grade > 20)

query I
SELECT id FROM squad ORDER BY id;
----
1

query I
SELECT count(*) FROM squad WHERE CASE WHEN grade = 21 THEN error('leak babsky') ELSE true END;
----
1

query I
SELECT count(*) FROM squad WHERE CASE WHEN grade = 13 THEN error('leak arelav row') ELSE true END;
----
1

statement ok
DROP POLICY skuf_only ON squad;

statement ok
INSERT INTO squad VALUES (4, 'arelav', 1, 'new');

statement error
INSERT INTO squad VALUES (5, 'babsky', 1, 'nope');
----
<REGEX>:.*new row violates row-level security policy for table "squad".*

statement error
UPDATE squad SET member = 'babsky' WHERE id = 4;
----
<REGEX>:.*new row violates row-level security policy for table "squad".*

statement ok
UPDATE squad SET grade = 0;

statement ok
DELETE FROM squad WHERE id = 4;

statement ok
ALTER TABLE squad NO FORCE ROW LEVEL SECURITY;

query III
SELECT id, member, grade FROM squad ORDER BY id;
----
1	arelav	0
2	babsky	21
3	arelav	0

statement ok
ALTER POLICY arelav_rows ON squad RENAME TO arelav_only;

statement ok
ALTER TABLE squad FORCE ROW LEVEL SECURITY;

statement ok
ALTER TABLE squad RENAME COLUMN member TO who;

query I
SELECT count(*) FROM squad;
----
2

query II
SELECT policy_name, using_expression FROM duckdb_policies();
----
arelav_only	(who = 'arelav')

statement ok
ALTER POLICY arelav_only ON squad USING (who = 'babsky');

query I
SELECT id FROM squad;
----
2

statement ok
ALTER POLICY arelav_only ON squad USING (who = 'arelav') WITH CHECK (grade = 0);

statement error
INSERT INTO squad VALUES (6, 'arelav', 1, 'x');
----
<REGEX>:.*new row violates row-level security policy for table "squad".*

statement error
ALTER POLICY nope ON squad RENAME TO nothing;
----
<REGEX>:.*policy "nope" for table "squad" does not exist.*

statement ok
ALTER TABLE squad RENAME TO squad_board;

statement ok
ALTER TABLE squad_board RENAME TO squad;

query I
SELECT count(*) FROM squad;
----
2

statement ok
BEGIN;

statement ok
DROP POLICY arelav_only ON squad;

query I
SELECT count(*) FROM squad;
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM squad;
----
