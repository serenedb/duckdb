statement ok
ALTER TABLE board ENABLE ROW LEVEL SECURITY;

statement ok
ALTER TABLE board FORCE ROW LEVEL SECURITY;

statement ok
CREATE POLICY board_team ON board USING (team IN (SELECT team FROM members));

query I
