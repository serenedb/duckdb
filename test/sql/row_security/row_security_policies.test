statement ok
CREATE TABLE tasks (id INTEGER, who VARCHAR, v INTEGER);

statement ok
INSERT INTO tasks VALUES (1, 'babsky', 0);

statement ok
ALTER TABLE tasks ENABLE ROW LEVEL SECURITY;

statement ok
ALTER TABLE tasks FORCE ROW LEVEL SECURITY;

statement ok
CREATE POLICY tasks_read ON tasks FOR SELECT USING (true);

statement ok
CREATE POLICY tasks_write ON tasks FOR UPDATE USING (true) WITH CHECK (who = 'arelav');

statement error
UPDATE tasks SET v = 1;
----
<REGEX>:.*new row violates row-level security policy for table "tasks".*

statement ok
UPDATE tasks SET who = 'arelav', v = 2;

statement ok
ALTER POLICY tasks_write ON tasks WITH CHECK (1 = 0);

statement error
UPDATE tasks SET v = 3;
----
<REGEX>:.*new row violates row-level security policy for table "tasks".*

statement ok
ALTER POLICY tasks_write ON tasks WITH CHECK (who = current_user);

statement error
UPDATE tasks SET v = 4;
----
<REGEX>:.*new row violates row-level security policy for table "tasks".*

query II
SELECT who, v FROM tasks;
----
arelav	2

