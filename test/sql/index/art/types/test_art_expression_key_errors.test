# name: test/sql/index/art/types/test_art_expression_key_errors.test
# description: An error in an index key expression fails the write that evaluates it
# group: [types]

statement ok
CREATE TABLE fractions(a INTEGER, b INTEGER)

statement ok
CREATE INDEX fractions_ratio ON fractions((a // b))

statement error
INSERT INTO fractions VALUES (6, 0)
----
Division by zero

statement ok
INSERT INTO fractions VALUES (6, 7)

query II
SELECT a, b FROM fractions
----
6	7
