# name: test/sql/index/art/create_drop/test_art_partial_index_empty_build.test
# description: A partial index whose predicate no row satisfies builds and is published.
# group: [create_drop]

statement ok
CREATE TABLE t (a INTEGER);

statement ok
CREATE UNIQUE INDEX empty_table ON t (a) WHERE a > 5;

statement ok
INSERT INTO t VALUES (1), (2);

statement ok
CREATE UNIQUE INDEX below_range ON t (a) WHERE a > 5;

statement ok
CREATE INDEX constant_false ON t (a) WHERE false;

statement ok
CREATE INDEX constant_null ON t (a) WHERE NULL;

query I
SELECT index_name FROM duckdb_indexes() WHERE table_name = 't' ORDER BY index_name;
