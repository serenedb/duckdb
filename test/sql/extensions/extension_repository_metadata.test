# name: test/sql/extensions/extension_repository_metadata.test
# description: A repository created without a key reads its signature keys from the JSON metadata file served at its prefix, and a metadata file of the wrong shape is rejected
# group: [extensions]

statement ok
SET extension_repository_directory='{TEST_DIR}/repository_metadata_repositories'

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/repository_metadata' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/repository_metadata/.well-known' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT '{"signature_keys":[""]}') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

query III
CREATE EXTENSION REPOSITORY served WITH PREFIX '{TEST_DIR}/repository_metadata'
----
served	{TEST_DIR}/repository_metadata	['sha256:172c29bbb3cd41c70a8225d36ba3a53c94ca9236389fba11a71d45ef0524fa3b']

statement ok
DROP EXTENSION REPOSITORY served

statement ok
COPY (SELECT 'not json') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
the file is not valid json

statement ok
COPY (SELECT '[""]') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
expected a json object

statement ok
COPY (SELECT '{"keys":[""]}') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
missing or invalid field 'signature_keys'

statement ok
COPY (SELECT '{"signature_keys":""}') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
missing or invalid field 'signature_keys'

statement ok
COPY (SELECT '{"signature_keys":[2048]}') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
'signature_keys' must be a list of strings

statement ok
COPY (SELECT '{"signature_keys":[]}') TO '{TEST_DIR}/repository_metadata/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY broken WITH PREFIX '{TEST_DIR}/repository_metadata'
----
'signature_keys' cannot be empty

query I
SELECT count(*) FROM duckdb_extension_repositories() WHERE type='USER_PROVIDED'
----
0
