# name: test/sql/attach/attach_if_not_exists_detach.test
# description: Test ATTACH IF NOT EXISTS
# group: [attach]

statement ok
ATTACH '{TEST_DIR}/attach_if_not_exists_detach.db' AS db1

# con1 opens a transaction for db1 that prevents it from being fully detached
statement ok con1
BEGIN

statement ok con1
CREATE TABLE db1.tbl(i INTEGER);

# con2 can detach db1, but it will not actually be detached
statement ok con2
DETACH db1

# con1 still holds the file open, so attaching hands that same database back instead of opening it twice
statement ok con2
ATTACH IF NOT EXISTS '{TEST_DIR}/attach_if_not_exists_detach.db' AS db1

statement ok con1
COMMIT

# con2 sees what con1 committed, i.e. it got the same database rather than a second one over the file
query I con2
SELECT count(*) FROM db1.tbl
----
0
