# name: test/sql/aggregate/group/test_group_by_finalize_slices.test
# description: Hash aggregates whose fixed-width partitions are finalized in slices
# group: [group]

statement ok
SET threads=8

query IIII
SELECT count(*), sum(c), min(c), max(c) FROM (SELECT i % 3000000 AS k, count(*) AS c FROM range(12000000) t(i) GROUP BY k)
----
3000000	12000000	4	4

query IIII
SELECT count(*), sum(s), count(DISTINCT k1), max(c) FROM (SELECT i % 1500000 AS k1, (i // 7) % 3 AS k2, count(*) AS c, sum(i) AS s FROM range(9000000) t(i) GROUP BY k1, k2)
----
4500000	40499995500000	1500000	3

query III
SELECT count(*), count(k), sum(c) FROM (SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i % 2000000 END AS k, count(*) AS c FROM range(8000000) t(i) GROUP BY k)
----
1800001	1800000	8000000

query II
SELECT k % 7, count(DISTINCT v) FROM (SELECT i % 2500000 AS k, i % 11 AS v FROM range(10000000) t(i)) GROUP BY ALL ORDER BY 1
----
0	11
1	11
2	11
3	11
4	11
5	11
6	11
