statement ok
COPY (SELECT i, CASE WHEN i % 2 = 0 THEN 'a' || i || 'z' ELSE 'bbbb' END AS s FROM range(10000) t(i)) TO '{TEMP_DIR}/plain_boundaries.parquet';

query I
SELECT count(*) FROM '{TEMP_DIR}/plain_boundaries.parquet' WHERE s LIKE '%z' || chr(4) || '%';
----
0

query II
SELECT count(*), sum(i) FROM '{TEMP_DIR}/plain_boundaries.parquet' WHERE s LIKE '%8z%';
----
1000	5003000

query II
SELECT count(*), sum(i) FROM '{TEMP_DIR}/plain_boundaries.parquet' WHERE s LIKE '%b%';
----
5000	25000000
