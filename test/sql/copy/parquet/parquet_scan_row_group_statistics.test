# name: test/sql/copy/parquet/parquet_scan_row_group_statistics.test
# description: The row group statistics of one parquet file are those of the columns the scan reads
# group: [parquet]

require parquet

statement ok
COPY (SELECT {'a': i} AS s FROM range(300000) t(i)) TO '{TEST_DIR}/row_group_statistics_struct.parquet' (FORMAT parquet, ROW_GROUP_SIZE 100000)

query I
SELECT s.a FROM read_parquet('{TEST_DIR}/row_group_statistics_struct.parquet') ORDER BY s.a LIMIT 3 OFFSET 150000
----
150000
150001
150002

statement ok
COPY (SELECT 5 AS a, 0 AS b) TO '{TEST_DIR}/row_group_statistics_hive' (FORMAT parquet, PARTITION_BY (a))

statement ok
COPY (SELECT i AS a, i AS b FROM range(300000) t(i)) TO '{TEST_DIR}/row_group_statistics_hive/a=5/data.parquet' (FORMAT parquet, ROW_GROUP_SIZE 100000)

query III
SELECT max(a), min(a), count(*) FROM read_parquet('{TEST_DIR}/row_group_statistics_hive/a=5/data.parquet', hive_partitioning = true) WHERE b >= 50000
----
5	5	250000

query II
SELECT max(a), min(a) FROM read_parquet('{TEST_DIR}/row_group_statistics_hive/a=5/data.parquet', hive_partitioning = true)
----
5	5

query II
SELECT a, b FROM read_parquet('{TEST_DIR}/row_group_statistics_hive/a=5/data.parquet', hive_partitioning = true) ORDER BY a, b LIMIT 3 OFFSET 150000
----
5	150000
5	150001
5	150002

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/row_group_statistics_ties_1.parquet' (FORMAT parquet)

statement ok
COPY (SELECT a FROM (VALUES (1), (3)) v(a)) TO '{TEST_DIR}/row_group_statistics_ties_2.parquet' (FORMAT parquet)

statement ok
COPY (SELECT 2 AS a) TO '{TEST_DIR}/row_group_statistics_ties_3.parquet' (FORMAT parquet)

query I
SELECT a FROM read_parquet(['{TEST_DIR}/row_group_statistics_ties_1.parquet', '{TEST_DIR}/row_group_statistics_ties_2.parquet', '{TEST_DIR}/row_group_statistics_ties_3.parquet']) ORDER BY a LIMIT 3
----
1
1
2
