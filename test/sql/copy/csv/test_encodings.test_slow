# name: test/sql/copy/csv/test_encodings.test_slow
# description: Test reading a CSV file with a set encoding
# group: [csv]

statement ok
FROM read_csv('{DATA_DIR}/csv/test/test.csv', encoding = 'utf-8')

statement ok
FROM read_csv('{DATA_DIR}/csv/test/test.csv', encoding = 'utf-16')

statement ok
FROM read_csv('{DATA_DIR}/csv/test/test.csv', encoding = 'latin-1')

statement ok
create table test (a INTEGER, b INTEGER, c VARCHAR(10));

statement ok
COPY test FROM '{DATA_DIR}/csv/test/test.csv' (encoding 'utf-8');

# We error for not supported encodings, sorry goku, but soon.
statement error
FROM read_csv('{DATA_DIR}/csv/test/test.csv', encoding = 'Shift-JIS')
----
The CSV Reader does not support the encoding: "Shift-JIS"

# Writing not supported
statement error
COPY test TO '{DATA_DIR}/csv/test/test.csv' (encoding 'utf-16');
----
Option "encoding" is not supported for writing - only for reading

statement error
FROM read_csv('{DATA_DIR}/csv/encodings/latin1.csv')
----
Invalid unicode (byte sequence mismatch) detected.

statement ok
drop table test;

statement ok
create table test (a varchar, b integer)

statement ok
COPY test FROM '{DATA_DIR}/csv/encodings/latin1.csv' (encoding 'latin-1');

