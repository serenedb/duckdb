----
File is not utf-16 encoded

# Every byte 0x00-0xFF is valid ISO-8859-1 -- 0x80-0x9F are the C1 controls, which map to
# U+0080-U+009F -- so decoding any file as latin-1 succeeds (with mojibake for a file that was
# not actually latin-1). PostgreSQL agrees: COPY ... WITH (ENCODING 'LATIN1') reads this file.
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/encodings/shift_jis.csv', encoding = 'latin-1')
----
20

