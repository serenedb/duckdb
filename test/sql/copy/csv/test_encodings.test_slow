# large-file decode (utf-32le): whole file, utf-32le code units
query I
SELECT count (*) FROM read_csv('{DATA_DIR}/csv/encodings/all_utf32le.csv', encoding = 'utf-32le', header = 0, quote = '', auto_detect = false, columns = {'a':'varchar'}, delim = '')
----
63489

# large-file decode (utf-32be): whole file, utf-32be code units
query I
SELECT count (*) FROM read_csv('{DATA_DIR}/csv/encodings/all_utf32be.csv', encoding = 'utf-32be', header = 0, quote = '', auto_detect = false, columns = {'a':'varchar'}, delim = '')
----
63489

# ============================================================================
# Encoded-buffer boundary handling: surrogate pairs / code units split across
# file reads (tiny buffer_size), and truncated files
# ============================================================================

# utf16(le|be)_astral_run.csv: "ab" header + 50 one-emoji rows. The header is 3
# code units, so 4-aligned encoded-buffer boundaries land mid-surrogate-pair;
# the split pair is held back and carried into the next read.
foreach buffer_size 16 18 34 101

query II
SELECT count(*), sum(length(ab)) FROM read_csv('{DATA_DIR}/csv/encodings/utf16le_astral_run.csv', encoding = 'utf-16', buffer_size = {buffer_size}, header = 1)
----
50	50

query II
SELECT count(*), sum(length(ab)) FROM read_csv('{DATA_DIR}/csv/encodings/utf16le_astral_run.csv', encoding = 'utf-16le', buffer_size = {buffer_size}, header = 1)
----
50	50

query II
SELECT count(*), sum(length(ab)) FROM read_csv('{DATA_DIR}/csv/encodings/utf16be_astral_run.csv', encoding = 'utf-16be', buffer_size = {buffer_size}, header = 1)
----
50	50

endloop

# utf-32 with buffer sizes that are NOT a multiple of the 4-byte code unit:
# the encoded buffer is rounded down to whole units and the tail carry
# reunites any split unit.
foreach buffer_size 42 47 50 64

query II
SELECT count(*), count(DISTINCT name) FROM read_csv('{DATA_DIR}/csv/encodings/utf32le.csv', encoding = 'utf-32le', buffer_size = {buffer_size})
----
20	20

query II
SELECT count(*), count(DISTINCT name) FROM read_csv('{DATA_DIR}/csv/encodings/utf32be.csv', encoding = 'utf-32be', buffer_size = {buffer_size})
----
20	20

endloop

# Truncated inputs fail cleanly at end-of-file instead of silently dropping the
# tail: a lone high surrogate / a partial 4-byte unit.
foreach buffer_size 16 1000000

statement error
FROM read_csv('{DATA_DIR}/csv/encodings/utf16le_truncated.csv', encoding = 'utf-16', buffer_size = {buffer_size}, header = 1)
----
File is not utf-16 encoded

statement error
FROM read_csv('{DATA_DIR}/csv/encodings/utf32le_truncated.csv', encoding = 'utf-32', buffer_size = {buffer_size}, header = 1)
----
File is not utf-32 encoded

endloop
