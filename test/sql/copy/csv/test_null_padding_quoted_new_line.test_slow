# name: test/sql/copy/csv/test_null_padding_quoted_new_line.test_slow
# description: Test CSV with nullpading interoping with quoted new line
# group: [csv]

statement ok
CREATE TABLE T as SELECT 'this line
has a new line' from range (1000000);

statement ok
COPY T TO '{TEST_DIR}/test_null_padding_quoted_new_line.csv' (FORMAT CSV , FORCE_QUOTE *);

query I
select count(*) FROM read_csv('{TEST_DIR}/test_null_padding_quoted_new_line.csv', null_padding = true)
----
1000000

query I
select count(*) FROM read_csv('{TEST_DIR}/test_null_padding_quoted_new_line.csv')
----
1000000