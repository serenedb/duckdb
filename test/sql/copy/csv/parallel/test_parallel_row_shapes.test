# name: test/sql/copy/csv/parallel/test_parallel_row_shapes.test
# description: Comment lines, multi-byte delimiters and short rows padded with NULL read the same over many small ranges
# group: [parallel]

require skip_reload

statement ok
COPY (SELECT CASE WHEN i % 7 = 3 THEN '#note ' || i || ',x' ELSE i || ',' || (i * 3) || ',v' || i END FROM range(2000) t(i)) TO '{TEMP_DIR}/row_shapes_comments.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
COPY (SELECT CASE WHEN i % 7 = 3 THEN '#note ' || i || '||x' ELSE i || '||' || (i * 3) || '||v' || i END FROM range(2000) t(i)) TO '{TEMP_DIR}/row_shapes_pipes.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
COPY (SELECT CASE WHEN i % 3 = 0 THEN i::VARCHAR WHEN i % 3 = 1 THEN i || ',' || (i * 3) WHEN i % 5 = 4 THEN i || ',' || (i * 3) || ',' ELSE i || ',' || (i * 3) || ',v' || i END FROM range(2000) t(i)) TO '{TEMP_DIR}/row_shapes_ragged.csv' (HEADER false, DELIMITER '\t', QUOTE '');

foreach buffer_size 64 100 333 100000

foreach parallel true false

query I
SELECT count(*) FROM (
	(SELECT a, b, c FROM read_csv('{TEMP_DIR}/row_shapes_comments.csv', comment = '#', delim = ',', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel})
	 EXCEPT ALL SELECT i, i * 3, 'v' || i FROM range(2000) t(i) WHERE i % 7 <> 3)
	UNION ALL
	(SELECT i, i * 3, 'v' || i FROM range(2000) t(i) WHERE i % 7 <> 3
	 EXCEPT ALL SELECT a, b, c FROM read_csv('{TEMP_DIR}/row_shapes_comments.csv', comment = '#', delim = ',', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel}))
)
----
0

