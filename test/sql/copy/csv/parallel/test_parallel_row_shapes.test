	 EXCEPT ALL SELECT a, b, c FROM read_csv('{TEMP_DIR}/row_shapes_pipes.csv', comment = '#', delim = '||', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel}))
)
