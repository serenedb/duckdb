query I
SELECT count(*) FROM (
	(SELECT a, b, c FROM read_csv('{TEMP_DIR}/row_shapes_ragged.csv', null_padding = true, delim = ',', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel})
	 EXCEPT ALL SELECT i, CASE WHEN i % 3 <> 0 THEN i * 3 END, CASE WHEN i % 3 = 2 AND i % 5 <> 4 THEN 'v' || i END FROM range(2000) t(i))
	UNION ALL
	(SELECT i, CASE WHEN i % 3 <> 0 THEN i * 3 END, CASE WHEN i % 3 = 2 AND i % 5 <> 4 THEN 'v' || i END FROM range(2000) t(i)
	 EXCEPT ALL SELECT a, b, c FROM read_csv('{TEMP_DIR}/row_shapes_ragged.csv', null_padding = true, delim = ',', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel}))
)
----
0

query II
SELECT count(*), count(c) FROM read_csv('{TEMP_DIR}/row_shapes_ragged.csv', null_padding = true, delim = ',', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel})
