query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/ranges.csv', buffer_size = 40) r, read_text('{TEMP_DIR}/ranges.csv') f
WHERE substr(f.content, r.file_row_number + 1, length(r.id::VARCHAR) + 1) <> r.id::VARCHAR || ','
