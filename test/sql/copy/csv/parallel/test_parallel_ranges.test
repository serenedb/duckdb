SELECT count(*), sum(a), sum(length(s)) FROM read_csv('{TEMP_DIR}/ranges_mixed_cr_end.csv', columns = {'a': 'INTEGER', 's': 'VARCHAR'}, header = false, auto_detect = false, new_line = '\r\n', strict_mode = false, buffer_size = {buffer_size});
