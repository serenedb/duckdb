query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/ranges.csv', buffer_size = 40) r, read_text('{TEMP_DIR}/ranges.csv') f
WHERE substr(f.content, r.file_row_number + 1, length(r.id::VARCHAR) + 1) <> r.id::VARCHAR || ','
----
0

statement ok
COPY (SELECT i, 'a' || chr(13) || chr(10) || repeat('z', i % 5) AS s FROM range(300) t(i)) TO '{TEMP_DIR}/ranges_crlf.csv' (HEADER false, NEW_LINE '\r\n');

foreach name,last,writer_new_line cr_end,'',\r lf_end,'',\n cr_row,chr(13)||'200'||chr(44)||'b',\n

statement ok
COPY (SELECT string_agg(i::VARCHAR || ',"a' || chr(13) || chr(10) || repeat('z', i % 5) || '"' || CASE WHEN i = 199 THEN {last} WHEN i % 3 = 0 THEN chr(13) || chr(10) WHEN i % 3 = 1 THEN chr(10) ELSE chr(13) END, '' ORDER BY i) FROM range(200) t(i)) TO '{TEMP_DIR}/ranges_mixed_{name}.csv' (HEADER false, QUOTE '', ESCAPE '', NEW_LINE '{writer_new_line}');

endloop

loop buffer_size 20 40

