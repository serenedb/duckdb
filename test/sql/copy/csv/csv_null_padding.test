# name: test/sql/copy/csv/csv_null_padding.test
# description: Test nullpadding setting
# group: [csv]

# null padding with a header
query IIII
FROM read_csv_auto('{DATA_DIR}/csv/nullpadding_header.csv', null_padding=True, comment = '')
----
one	two	three	four
1	a	alice	NULL
2	b	bob	NULL

# without null padding we can only read one column
query I
FROM read_csv_auto('{DATA_DIR}/csv/nullpadding_header.csv', null_padding=False, header = 0)
----
# this file has a bunch of gunk at the top
one,two,three,four
1,a,alice
2,b,bob

query I
FROM read_csv_auto('{DATA_DIR}/csv/nullpadding_header.csv', null_padding=False, skip=1, header = 0, comment = '')
----
one,two,three,four
1,a,alice
2,b,bob

query III
FROM read_csv_auto('{DATA_DIR}/csv/nullpadding_header.csv', null_padding=False, skip=2)
----
1	a	alice
2	b	bob

query I
FROM read_csv_auto('{DATA_DIR}/csv/blank_line.csv', null_padding=True)
----
1
2
3
4
5
6
7
8
9
NULL
11

statement ok
COPY (SELECT CASE WHEN i % 3 = 0 THEN i || ',a' || i ELSE i || ',a' || i || ',b' || i END FROM range(300) t(i)) TO '{TEMP_DIR}/short_thirds.csv' (HEADER false, QUOTE '');

query IIIII
SELECT count(*), count(b), count(c), min(a), max(a) FROM read_csv('{TEMP_DIR}/short_thirds.csv', null_padding = true, columns = {'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'VARCHAR'});
----
300	300	200	0	299

query III
SELECT * FROM read_csv('{TEMP_DIR}/short_thirds.csv', null_padding = true, columns = {'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'VARCHAR'}) ORDER BY a LIMIT 2;
----
0	a0	NULL
1	a1	b1

statement error
SELECT * FROM read_csv('{TEMP_DIR}/short_thirds.csv', columns = {'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'VARCHAR'});
----
