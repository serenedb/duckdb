# name: test/sql/copy/csv/test_csv_plain_blocks.test
# description: Fields spanning whole 64-byte blocks that hold nothing to end or change them, read by the general lexing step
# group: [csv]

statement ok
COPY (SELECT line FROM (VALUES (1, repeat('x', 100)), (2, 'y')) t(i, line) ORDER BY i)
TO '{TEMP_DIR}/first_line_long.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query I
SELECT length(a) FROM read_csv('{TEMP_DIR}/first_line_long.csv', columns={'a': 'VARCHAR'}, auto_detect=false, header=false)
ORDER BY 1 DESC;
----
100
1

statement ok
COPY (SELECT line FROM (VALUES (1, repeat('x', 200) || ',1'), (2, '; a comment line'), (3, 'yyy,2')) t(i, line) ORDER BY i)
TO '{TEMP_DIR}/comment_long.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query II
SELECT length(a), b FROM read_csv('{TEMP_DIR}/comment_long.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';',
                                  auto_detect=false, header=false)
ORDER BY b;
----
200	1
3	2

query II
SELECT length(a), b FROM read_csv('{TEMP_DIR}/comment_long.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';',
                                  ignore_errors=true, auto_detect=false, header=false)
ORDER BY b;
----
200	1
3	2

statement ok
COPY (SELECT line FROM (VALUES (1, 'short,1'), (2, repeat('x', 300) || ',2'), (3, 'ok,3')) t(i, line) ORDER BY i)
TO '{TEMP_DIR}/max_line_40.csv' (HEADER false, DELIMITER '|', QUOTE '~');

statement error
SELECT a, b FROM read_csv('{TEMP_DIR}/max_line_40.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, maximum_line_size=40,
                          auto_detect=false, header=false);
----
Maximum line size of 40 bytes exceeded. Actual Size:302 bytes.

query II
SELECT a, b FROM read_csv('{TEMP_DIR}/max_line_40.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, maximum_line_size=40,
                          ignore_errors=true, auto_detect=false, header=false)
ORDER BY b;
----
short	1
ok	3

statement ok
COPY (SELECT line FROM (VALUES (1, '"' || repeat('x', 200) || '",1'), (2, '"a\"b",2')) t(i, line) ORDER BY i)
TO '{TEMP_DIR}/quoted_escape.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query III
SELECT length(a), a[1:3], b FROM read_csv('{TEMP_DIR}/quoted_escape.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'},
                                          quote='"', escape='\', auto_detect=false, header=false)
ORDER BY b;
----
200	xxx	1
3	a"b	2

statement ok
COPY (SELECT line FROM (VALUES (1, repeat(' ', 128) || ',1'), (2, repeat(' ', 64) || 'abc,2'),
                               (3, repeat(' ', 10) || repeat('z', 100) || ',3'), (4, repeat(' ', 70) || '; blank before a comment')) t(i, line)
      ORDER BY i)
TO '{TEMP_DIR}/blank_fields.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query III
SELECT length(a), trim(a), b FROM read_csv('{TEMP_DIR}/blank_fields.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';',
                                           auto_detect=false, header=false)
ORDER BY b;
----
128	(empty)	1
67	abc	2
110	zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz	3

query III
SELECT length(a), trim(a), b FROM read_csv('{TEMP_DIR}/blank_fields.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';',
                                           ignore_errors=true, auto_detect=false, header=false)
ORDER BY b;
----
128	(empty)	1
67	abc	2
110	zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz	3

statement ok
SET threads = 8;

statement ok
COPY (SELECT '"' || repeat(chr(97 + (i % 26)::INTEGER), 300) || '",' || i AS line FROM range(40) t(i))
TO '{TEMP_DIR}/quoted_rows.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query IIIII
SELECT count(*), sum(b), sum(length(a)), min(a[1:1]), max(a[1:1])
FROM read_csv('{TEMP_DIR}/quoted_rows.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, quote='"', escape='\', buffer_size=1024,
              auto_detect=false, header=false);
----
40	780	12000	a	z

statement ok
COPY (SELECT repeat(chr(97 + (i % 26)::INTEGER), 300) || ',' || i AS line FROM range(40) t(i))
TO '{TEMP_DIR}/plain_rows.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query III
SELECT count(*), sum(b), sum(length(a))
FROM read_csv('{TEMP_DIR}/plain_rows.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';', buffer_size=1024,
              auto_detect=false, header=false);
----
40	780	12000

query III
SELECT count(*), sum(b), sum(length(a))
FROM read_csv('{TEMP_DIR}/plain_rows.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';', ignore_errors=true,
              buffer_size=1024, auto_detect=false, header=false);
----
40	780	12000

statement ok
COPY (SELECT repeat(chr(97 + (i % 26)::INTEGER), CASE WHEN i = 20 THEN 3000 ELSE 300 END) || ',' || i AS line FROM range(40) t(i))
TO '{TEMP_DIR}/one_long_row.csv' (HEADER false, DELIMITER '|', QUOTE '~');

query III
SELECT count(*), sum(b), sum(length(a))
FROM read_csv('{TEMP_DIR}/one_long_row.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';', ignore_errors=true,
              buffer_size=1024, auto_detect=false, header=false);
----
39	760	11700

statement error
SELECT count(*) FROM read_csv('{TEMP_DIR}/one_long_row.csv', columns={'a': 'VARCHAR', 'b': 'INTEGER'}, comment=';',
                              buffer_size=1024, auto_detect=false, header=false);
----
Maximum line size of 1024 bytes exceeded. Actual Size:3003 bytes.

statement ok
COPY (SELECT '"' || repeat('q', 200) || '"||' || i AS line FROM range(10) t(i))
TO '{TEMP_DIR}/double_delimiter.csv' (HEADER false, QUOTE '', ESCAPE '');

query III
SELECT Delimiter, Quote, Escape FROM sniff_csv('{TEMP_DIR}/double_delimiter.csv', delim='||', header=false);
----
||	"	(empty)

query IIII
SELECT count(*), sum(column1), min(length(column0)), max(length(column0))
FROM read_csv('{TEMP_DIR}/double_delimiter.csv', delim='||', header=false);
----
10	45	200	200

statement ok
COPY (SELECT CASE WHEN i = 0 THEN 'ab"c||' ELSE 'abc||' END || '"' || repeat('q', 200) || '"||' || i AS line FROM range(10) t(i))
TO '{TEMP_DIR}/stray_quote.csv' (HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT Delimiter, Quote, Escape, Columns FROM sniff_csv('{TEMP_DIR}/stray_quote.csv', delim='||', header=false);
----
||	"	(empty)	[{'name': column0, 'type': VARCHAR}, {'name': column1, 'type': VARCHAR}, {'name': column2, 'type': BIGINT}]

query IIII
SELECT count(*), sum(column2), min(length(column1)), max(column0)
FROM read_csv('{TEMP_DIR}/stray_quote.csv', delim='||', header=false, strict_mode=false);
----
10	45	200	abc

statement ok
COPY (SELECT '"' || chr(10) || 'ab",' || repeat(chr(97 + (i % 26)::INTEGER), 300) || ',' || i AS line FROM range(40) t(i))
TO '{TEMP_DIR}/quoted_newlines.csv' (HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT count(*), sum(c), sum(length(b)), min(a = chr(10) || 'ab')
FROM read_csv('{TEMP_DIR}/quoted_newlines.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'INTEGER'}, comment=';',
              buffer_size=1024, auto_detect=false, header=false);
----
40	780	12000	true
