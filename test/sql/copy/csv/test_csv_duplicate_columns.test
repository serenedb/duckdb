# name: test/sql/copy/csv/test_csv_duplicate_columns.test
# group: [csv]

require parquet


statement ok
COPY (SELECT 1 as a, 2 as a, 3 as a) TO '{TEST_DIR}/dupe_cols.csv' (FORMAT CSV, HEADER);

# The duplicate column(s) get `:{index}` appended to it
query III
SELECT a, "a:1", "a:2" FROM '{TEST_DIR}/dupe_cols.csv';
----
1	2	3

statement ok
COPY (SELECT 1 as a, 2 as a, 3 as "a:1") TO '{TEST_DIR}/dupe_cols.csv' (FORMAT CSV, HEADER);

query III
SELECT a, "a:2", "a:1" FROM '{TEST_DIR}/dupe_cols.csv';
----
1	2	3

statement ok
COPY (SELECT 1 as a, 3 as "a:1", 2 as a) TO '{TEST_DIR}/dupe_cols.csv' (FORMAT CSV, HEADER);

query III
SELECT a, "a:1", "a:2" FROM '{TEST_DIR}/dupe_cols.csv';
----
1	3	2
