# name: test/sql/copy/csv/test_csv_raw_predicates.test
# description: String comparisons, IN lists and NULL checks pushed into read_csv give the rows the same filters give above the scan
# group: [csv]

require skip_reload

statement ok
CREATE TABLE raw_source AS SELECT
	i AS id,
	CASE i % 9
		WHEN 0 THEN NULL
		WHEN 1 THEN ''
		WHEN 2 THEN 'alpha'
		WHEN 3 THEN 'alp"ha'
		WHEN 4 THEN 'beta,' || (i % 5)
		WHEN 5 THEN 'NULL'
		WHEN 6 THEN 'gamma ' || (i % 3)
		WHEN 7 THEN 'alphabet'
		ELSE 'zeta'
	END AS s,
	CASE WHEN i % 4 = 0 THEN NULL ELSE i * 3 END AS n
FROM range(5000) r(i);

statement ok
COPY raw_source TO '{TEMP_DIR}/raw_quoted.csv' (HEADER false);

statement ok
COPY raw_source TO '{TEMP_DIR}/raw_nullstr.csv' (HEADER false, NULL 'NULL', FORCE_QUOTE (s));

statement ok
COPY (SELECT line FROM (SELECT id, concat_ws(',', id, coalesce(replace(s, ',', ';'), ''), coalesce(n::VARCHAR, '')) AS line FROM raw_source UNION ALL SELECT i + 0.5, 'bad,row,x,y' FROM range(0, 5000, 700) r(i)) ORDER BY id) TO '{TEMP_DIR}/raw_bad.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
CREATE MACRO raw_columns() AS {'id': 'BIGINT', 's': 'VARCHAR', 'n': 'BIGINT'};

statement ok
CREATE TABLE raw_quoted AS FROM read_csv('{TEMP_DIR}/raw_quoted.csv', header = false, auto_detect = false, columns = raw_columns());

statement ok
CREATE TABLE raw_nullstr AS FROM read_csv('{TEMP_DIR}/raw_nullstr.csv', header = false, auto_detect = false, nullstr = 'NULL', columns = raw_columns());

statement ok
CREATE TABLE raw_bad AS FROM read_csv('{TEMP_DIR}/raw_bad.csv', header = false, auto_detect = false, ignore_errors = true, columns = raw_columns());

foreach predicate s='alpha' s<>'alpha' s<'beta' s>='gamma' (s)IN('alpha','zeta','NULL') (s)LIKE'alp%' (s)ISNULL (s)NOTNULL (n)ISNULL (n)NOTNULL s='alp"ha' s='' (s>'a'AND(s<'b'))

foreach parallel true false

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/raw_quoted.csv', header = false, auto_detect = false, columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate} EXCEPT ALL FROM raw_quoted WHERE ${predicate})
	UNION ALL
	(FROM raw_quoted WHERE ${predicate} EXCEPT ALL FROM read_csv('{TEMP_DIR}/raw_quoted.csv', header = false, auto_detect = false, columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate})
)
----
0

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/raw_nullstr.csv', header = false, auto_detect = false, nullstr = 'NULL', columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate} EXCEPT ALL FROM raw_nullstr WHERE ${predicate})
	UNION ALL
	(FROM raw_nullstr WHERE ${predicate} EXCEPT ALL FROM read_csv('{TEMP_DIR}/raw_nullstr.csv', header = false, auto_detect = false, nullstr = 'NULL', columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate})
)
----
0

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/raw_bad.csv', header = false, auto_detect = false, ignore_errors = true, columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate} EXCEPT ALL FROM raw_bad WHERE ${predicate})
	UNION ALL
	(FROM raw_bad WHERE ${predicate} EXCEPT ALL FROM read_csv('{TEMP_DIR}/raw_bad.csv', header = false, auto_detect = false, ignore_errors = true, columns = raw_columns(), parallel = {parallel}, buffer_size = 1024) WHERE ${predicate})
)
----
0

endloop

endloop

query II
SELECT count(*), count(s) FROM read_csv('{TEMP_DIR}/raw_quoted.csv', header = false, auto_detect = false, columns = raw_columns()) WHERE s = 'alpha' OR s IS NULL
----
1668	556
