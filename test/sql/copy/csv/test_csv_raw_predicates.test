statement ok
RESET disabled_optimizers;

statement ok
COPY (SELECT CASE WHEN i % 5 = 0 THEN i::VARCHAR WHEN i % 5 = 1 THEN i || ',' || (['alpha', 'beta', 'gamma'])[i % 3 + 1] ELSE i || ',' || (['alpha', 'beta', 'gamma', 'alphabet'])[i % 4 + 1] || ',' || (i * 3) END FROM range(3000) r(i) ORDER BY i) TO '{TEMP_DIR}/raw_padded.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
COPY (SELECT i || ',' || (['al\pha', 'beta', 'x\y', 'alpha'])[i % 4 + 1] || ',' || (i * 3) FROM range(3000) r(i) ORDER BY i) TO '{TEMP_DIR}/raw_escaped.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
COPY (SELECT i || ',' || (['""', '', 'alpha', '"beta"'])[i % 4 + 1] || ',' || (i * 3) FROM range(3000) r(i) ORDER BY i) TO '{TEMP_DIR}/raw_quoted_empty.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
CREATE TABLE raw_padded AS FROM read_csv('{TEMP_DIR}/raw_padded.csv', header = false, auto_detect = false, null_padding = true, columns = raw_columns());

statement ok
CREATE TABLE raw_escaped AS FROM read_csv('{TEMP_DIR}/raw_escaped.csv', header = false, auto_detect = false, escape = '\', strict_mode = false, columns = raw_columns());

statement ok
CREATE TABLE raw_quoted_empty AS FROM read_csv('{TEMP_DIR}/raw_quoted_empty.csv', header = false, auto_detect = false, allow_quoted_nulls = false, columns = raw_columns());

