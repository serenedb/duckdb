statement ok
COPY (SELECT 'r' || lpad(i::VARCHAR, 6, '0') || ',v' || lpad(i::VARCHAR, 6, '0') FROM range(128) r(i) ORDER BY i) TO '{TEMP_DIR}/exact_buffers.csv.gz' (HEADER false, DELIMITER '\t', QUOTE '', COMPRESSION gzip);

query II
WITH RECURSIVE t(i, c) AS (
	SELECT 1, 0
	UNION ALL
	(SELECT t.i + 1, r.c FROM t, (SELECT count(*) AS c FROM read_csv('{TEMP_DIR}/exact_buffers.csv.gz', header = false, buffer_size = 1024, parallel = false)) r WHERE t.i < 3)
)
SELECT i, c FROM t ORDER BY i;
----
1	0
2	128
3	128

query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/exact_buffers.csv.gz', auto_detect = false, header = false, skip = 200, buffer_size = 1024, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
0

