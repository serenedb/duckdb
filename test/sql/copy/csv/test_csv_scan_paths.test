# name: test/sql/copy/csv/test_csv_scan_paths.test
# description: Counting, sniffing and decoding paths of the CSV scan that only some inputs take
# group: [csv]

require skip_reload

statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/invalid_utf8_first_column.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
Invalid unicode (byte sequence mismatch) detected

query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/invalid_utf8_first_column.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, ignore_errors = true);
----
2

query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/invalid_utf8_second_column.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
3

query I
SELECT count(b) FROM read_csv('{DATA_DIR}/csv/invalid_utf8_second_column.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, ignore_errors = true);
----
2

statement ok
COPY (FROM (VALUES ('1,234|5'), ('22,345|6'), ('3|7'))) TO '{TEMP_DIR}/thousands.csv' (HEADER false, DELIMITER '\t', QUOTE '');

query II
SELECT * FROM read_csv('{TEMP_DIR}/thousands.csv', delim = '|', thousands = ',', header = false);
----
1234	5
22345	6
3	7

query I
SELECT typeof(column0) FROM read_csv('{TEMP_DIR}/thousands.csv', delim = '|', thousands = ',', header = false) LIMIT 1;
----
BIGINT

statement ok
COPY (SELECT CASE WHEN x >= 1000 THEN (x // 1000)::VARCHAR || ',' || lpad((x % 1000)::VARCHAR, 3, '0') ELSE x::VARCHAR END || '|' || i FROM (SELECT i, i * 1000 + 7 AS x FROM range(3000) r(i)) ORDER BY i) TO '{TEMP_DIR}/thousands_long.csv' (HEADER false, DELIMITER '\t', QUOTE '');

query III
SELECT typeof(any_value(column0)), sum(column0), count(*) FROM read_csv('{TEMP_DIR}/thousands_long.csv', delim = '|', thousands = ',', header = false);
----
BIGNUM	4498521000	3000

statement ok
COPY (FROM (VALUES ('123456789012345678901234567890,1'), (' 42 ,2'), ('x,3'), ('-7,4'))) TO '{TEMP_DIR}/bignum.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement error
SELECT * FROM read_csv('{TEMP_DIR}/bignum.csv', auto_detect = false, header = false, columns = {'a': 'BIGNUM', 'b': 'INTEGER'});
----
Could not convert string "x" to 'BIGNUM'

query II
SELECT a + 1, b FROM read_csv('{TEMP_DIR}/bignum.csv', auto_detect = false, header = false, columns = {'a': 'BIGNUM', 'b': 'INTEGER'}, ignore_errors = true) ORDER BY b;
----
123456789012345678901234567891	1
43	2
-6	4

statement ok
CREATE TABLE copied (a BIGNUM, b INTEGER);

