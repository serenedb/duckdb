Could not convert string "fa\lse" to 'BOOLEAN'

foreach file bool_escape bool_escape_unquoted

query II
SELECT * FROM read_csv('{TEMP_DIR}/{file}.csv', auto_detect = false, header = false, escape = '\', strict_mode = false, ignore_errors = true, columns = {'b': 'BOOLEAN', 's': 'VARCHAR'}) ORDER BY s;
----
true	x
false	z

endloop

