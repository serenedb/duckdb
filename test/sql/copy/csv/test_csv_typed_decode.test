# name: test/sql/copy/csv/test_csv_typed_decode.test
# description: Every type the CSV scan decodes itself reads the same through the lexer, the exact splitter and the per-value path
# group: [csv]

require skip_reload

statement ok
CREATE TABLE typed AS SELECT
	i::INTEGER AS id,
	(i % 200 - 100)::TINYINT AS t,
	(i * 7 % 60000 - 30000)::SMALLINT AS s,
	(i * 1000003 % 2000000000 - 1000000000)::INTEGER AS n,
	(i * 1000000007 - 1500000000000)::BIGINT AS b,
	(i::HUGEINT * 100000000000000000000 - 7) AS h,
	(i % 256)::UTINYINT AS ut,
	(i * 7 % 65536)::USMALLINT AS us,
	(i * 1000003 % 4000000000)::UINTEGER AS ui,
	(i::UBIGINT * 1000000007) AS ub,
	(i::UHUGEINT * 100000000000000000000) AS uh,
	((i % 2000 - 1000) / 10)::DECIMAL(4,1) AS d1,
	((i * 37 % 10000000 - 5000000) / 100)::DECIMAL(9,2) AS d2,
	((i * 1000003 - 1500000000) / 1000)::DECIMAL(18,3) AS d3,
	((i::HUGEINT * 100000000000007 - 3) / 10000)::DECIMAL(30,4) AS d4,
	(i / 8 - 100)::DOUBLE AS fd,
	(i / 4 - 50)::FLOAT AS ff,
	(DATE '1999-12-01' + i::INTEGER) AS dt,
	(TIME '00:00:00' + INTERVAL (i * 13) SECOND) AS tm,
	(TIMESTAMP '2020-02-28 23:00:00' + INTERVAL (i * 7) MINUTE) AS ts,
	(i % 3 = 0) AS bo,
	('v' || i || repeat('x', i % 20)) AS v
FROM range(3000) r(i);

statement ok
COPY typed TO '{TEMP_DIR}/typed.csv' (HEADER false);

statement ok
COPY (SELECT * REPLACE (replace(d1::VARCHAR, '.', ',') AS d1, replace(d2::VARCHAR, '.', ',') AS d2, replace(d3::VARCHAR, '.', ',') AS d3, replace(d4::VARCHAR, '.', ',') AS d4, replace(fd::VARCHAR, '.', ',') AS fd, replace(ff::VARCHAR, '.', ',') AS ff) FROM typed) TO '{TEMP_DIR}/typed_comma.csv' (HEADER false, DELIMITER ';');

statement ok
COPY (SELECT line FROM (SELECT id, concat_ws(',', id, t, s, n, b, h, ut, us, ui, ub, uh, d1, d2, d3, d4, fd, ff, dt, tm, ts, bo, v) AS line FROM typed UNION ALL SELECT i * 500 + 1, 'bad,row,' || i FROM range(6) r(i)) ORDER BY id, line) TO '{TEMP_DIR}/typed_bad.csv' (HEADER false, DELIMITER '\t', QUOTE '');

statement ok
CREATE MACRO typed_columns() AS {'id': 'INTEGER', 't': 'TINYINT', 's': 'SMALLINT', 'n': 'INTEGER', 'b': 'BIGINT', 'h': 'HUGEINT', 'ut': 'UTINYINT', 'us': 'USMALLINT', 'ui': 'UINTEGER', 'ub': 'UBIGINT', 'uh': 'UHUGEINT', 'd1': 'DECIMAL(4,1)', 'd2': 'DECIMAL(9,2)', 'd3': 'DECIMAL(18,3)', 'd4': 'DECIMAL(30,4)', 'fd': 'DOUBLE', 'ff': 'FLOAT', 'dt': 'DATE', 'tm': 'TIME', 'ts': 'TIMESTAMP', 'bo': 'BOOLEAN', 'v': 'VARCHAR'};

foreach parallel true false

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/typed.csv', header = false, auto_detect = false, columns = typed_columns(), parallel = {parallel}, buffer_size = 4096) EXCEPT ALL FROM typed)
	UNION ALL
	(FROM typed EXCEPT ALL FROM read_csv('{TEMP_DIR}/typed.csv', header = false, auto_detect = false, columns = typed_columns(), parallel = {parallel}, buffer_size = 4096))
)
----
0

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/typed_comma.csv', header = false, auto_detect = false, delim = ';', decimal_separator = ',', columns = typed_columns(), parallel = {parallel}, buffer_size = 4096) EXCEPT ALL FROM typed)
	UNION ALL
	(FROM typed EXCEPT ALL FROM read_csv('{TEMP_DIR}/typed_comma.csv', header = false, auto_detect = false, delim = ';', decimal_separator = ',', columns = typed_columns(), parallel = {parallel}, buffer_size = 4096))
)
----
0

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/typed_comma.csv', header = false, auto_detect = false, delim = ';', decimal_separator = ',', thousands = '.', columns = typed_columns(), parallel = {parallel}, buffer_size = 4096) EXCEPT ALL FROM typed)
	UNION ALL
	(FROM typed EXCEPT ALL FROM read_csv('{TEMP_DIR}/typed_comma.csv', header = false, auto_detect = false, delim = ';', decimal_separator = ',', thousands = '.', columns = typed_columns(), parallel = {parallel}, buffer_size = 4096))
)
----
0

query I
SELECT count(*) FROM (
	(FROM read_csv('{TEMP_DIR}/typed_bad.csv', header = false, auto_detect = false, columns = typed_columns(), ignore_errors = true, parallel = {parallel}, buffer_size = 4096) EXCEPT ALL FROM typed)
	UNION ALL
	(FROM typed EXCEPT ALL FROM read_csv('{TEMP_DIR}/typed_bad.csv', header = false, auto_detect = false, columns = typed_columns(), ignore_errors = true, parallel = {parallel}, buffer_size = 4096))
)
----
0

endloop

