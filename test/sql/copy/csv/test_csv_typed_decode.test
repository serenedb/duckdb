CREATE MACRO error_columns() AS {'id': 'INTEGER', 't': 'TINYINT', 's': 'SMALLINT', 'n': 'INTEGER', 'b': 'BIGINT', 'h': 'HUGEINT', 'ut': 'UTINYINT', 'us': 'USMALLINT', 'ui': 'UINTEGER', 'ub': 'UBIGINT', 'uh': 'UHUGEINT', 'd1': 'DECIMAL(4,1)', 'd2': 'DECIMAL(9,2)', 'd3': 'DECIMAL(18,3)', 'd4': 'DECIMAL(30,4)', 'fd': 'DOUBLE', 'ff': 'FLOAT', 'dt': 'DATE', 'tm': 'TIME', 'ts': 'TIMESTAMP', 'bo': 'BOOLEAN'};

query IIIIIIIIIIIIIIIIIIIII
FROM read_csv('{TEMP_DIR}/typed_errors.csv', header = false, auto_detect = false, columns = error_columns(), store_rejects = true);
