# name: test/sql/json/table/read_json_strict.test
# description: strict JSON refuses NaN, Infinity and trailing commas, which the readers accept by default
# group: [table]

require json

statement ok
COPY (SELECT '{"a": NaN, "b": [1, 2,], "c": -Infinity,}' AS line) TO '{TEST_DIR}/lenient.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT isnan(a), b, c FROM read_ndjson('{TEST_DIR}/lenient.ndjson', columns := {a: 'DOUBLE', b: 'INTEGER[]', c: 'DOUBLE'});
----
true	[1, 2]	-inf

query I
SELECT json::VARCHAR FROM read_ndjson_objects('{TEST_DIR}/lenient.ndjson');
----
{"a": NaN, "b": [1, 2,], "c": -Infinity,}

statement error
SELECT * FROM read_ndjson('{TEST_DIR}/lenient.ndjson', columns := {a: 'DOUBLE', b: 'INTEGER[]', c: 'DOUBLE'}, strict := true);
----
<REGEX>:.*Malformed JSON.*

statement error
SELECT * FROM read_ndjson_objects('{TEST_DIR}/lenient.ndjson', strict := true);
----
<REGEX>:.*Malformed JSON.*

statement error
SELECT * FROM read_json('{TEST_DIR}/lenient.ndjson', strict := true);
----
<REGEX>:.*Malformed JSON.*

query II
SELECT count(*), count(json) FROM read_ndjson_objects('{TEST_DIR}/lenient.ndjson', strict := true, ignore_errors := true);
----
1	0

statement ok
COPY (SELECT '{"a": 1, "b": [1, 2], "c": 3}' AS line) TO '{TEST_DIR}/strict.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT a, b, c FROM read_ndjson('{TEST_DIR}/strict.ndjson', strict := true);
----
1	[1, 2]	3

statement ok
CREATE TABLE t (a DOUBLE, b INTEGER[], c DOUBLE);

statement ok
COPY t FROM '{TEST_DIR}/lenient.ndjson' (FORMAT json);

statement error
COPY t FROM '{TEST_DIR}/lenient.ndjson' (FORMAT json, STRICT true);
----
<REGEX>:.*Malformed JSON.*

statement ok
COPY t FROM '{TEST_DIR}/strict.ndjson' (FORMAT json, STRICT true);

query III
SELECT isnan(a), b, c FROM t ORDER BY c;
----
true	[1, 2]	-inf
false	[1, 2]	3.0

# commas before a closing bracket, NaN and Infinity inside strings are not lenient syntax
statement ok
COPY (SELECT '{"a": "NaN,]", "b": ["Infinity", "inf,}"], "c": null, "d": "nan"}' AS line) TO '{TEST_DIR}/strings.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT a, b, c, d FROM read_ndjson('{TEST_DIR}/strings.ndjson', strict := true);
----
NaN,]	[Infinity, 'inf,}']	NULL	nan

statement ok
COPY (SELECT '{"a": inf}' AS line) TO '{TEST_DIR}/inf.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT * FROM read_ndjson_objects('{TEST_DIR}/inf.ndjson', strict := true);
----
<REGEX>:.*Malformed JSON.*

query I
SELECT a FROM read_ndjson('{TEST_DIR}/inf.ndjson', columns := {a: 'DOUBLE'});
----
inf

statement ok
COPY (SELECT '[1, 2 ,	]' AS line) TO '{TEST_DIR}/comma_space.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT * FROM read_ndjson_objects('{TEST_DIR}/comma_space.ndjson', strict := true);
----
<REGEX>:.*Malformed JSON.*

query I
SELECT count(json) FROM read_ndjson_objects('{TEST_DIR}/strings.ndjson', strict := true);
----
1
