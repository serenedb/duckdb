# name: test/sql/json/table/read_json_validate.test
# description: counting records validates every key, string and number, from their raw text where it settles them and through the parser otherwise
# group: [table]

require json

statement ok
COPY (
	SELECT line FROM (VALUES
		(1, '{"s": "plain", "e": "a\"b", "u": "é", "k\"ey": 1, "b": "x\\y"}'),
		(2, '{"n": [-0, 0, 7, 1.5e-3, 1E+2, -12.75, 0.0e0, 123456789012345678901234567890, 1e999]}'),
		(3, '{"nan": NaN, "inf": Infinity, "ninf": -Infinity, "list": [1, 2,]}'),
		(4, '{"t": true, "f": false, "z": null, "o": {"a": [1, "x"]}}')) t(i, line)
	ORDER BY i
) TO '{TEST_DIR}/validate_tokens.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_ndjson('{TEST_DIR}/validate_tokens.ndjson', columns := {s: 'VARCHAR'});
----
4

query I
SELECT count(*) FROM read_json_objects('{TEST_DIR}/validate_tokens.ndjson', format := 'newline_delimited');
----
4

statement error
SELECT count(*) FROM read_ndjson('{TEST_DIR}/validate_tokens.ndjson', columns := {s: 'VARCHAR'}, strict := true);
----
<REGEX>:.*Malformed JSON.*

foreach bad {"a":"\x"} {"a\q":1} {"a":01} {"a":1.} {"a":-} {"a":.5} {"a":1e} {"a":1e+} {"a":"x"1}

statement ok
COPY (
	SELECT line FROM (VALUES (1, '{"a": 1}'), (2, '${bad}'), (3, '{"a": 2}')) t(i, line)
	ORDER BY i
) TO '{TEST_DIR}/validate_bad.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT count(*) FROM read_ndjson('{TEST_DIR}/validate_bad.ndjson', columns := {a: 'VARCHAR'});
----
<REGEX>:.*Malformed JSON.*line 2.*

endloop

statement ok
COPY (
	SELECT line FROM (VALUES
		(1, '{"t": 1' || chr(9) || '}'),
		(2, '{"r": 2' || chr(13) || '}'),
		(3, '{"e": [1e5, 2E+3, -0.5e-3]}'))
	t(i, line) ORDER BY i
) TO '{TEST_DIR}/validate_spaces.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_ndjson_objects('{TEST_DIR}/validate_spaces.ndjson');
----
3

foreach bad {"a":-} {"a":-.5} {"a":1.} {"a":1x} {"a":1e} {"a":1e5x} {"a":nul} {"a"1} {"a\q":1} [1,2 [1"x"] [tru]

statement ok
COPY (
	SELECT line FROM (VALUES (1, '{"a": 1}'), (2, '{bad}'), (3, '{"a": 2}')) t(i, line)
	ORDER BY i
) TO '{TEST_DIR}/validate_raw.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT count(*) FROM read_ndjson_objects('{TEST_DIR}/validate_raw.ndjson');
----
<REGEX>:.*Malformed JSON.*line 2.*

endloop

statement ok
COPY (
	SELECT line FROM (VALUES (1, '{"a": 1}'), (2, chr(65279) || '{"a": 2}'), (3, '{"a": 3}')) t(i, line)
	ORDER BY i
) TO '{TEST_DIR}/validate_bom.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT count(*) FROM read_ndjson_objects('{TEST_DIR}/validate_bom.ndjson');
----
at byte 1 in line 2: byte order mark (BOM) is not supported

query I
SELECT json FROM read_ndjson_objects('{TEST_DIR}/validate_bom.ndjson', ignore_errors := true);
----
{"a": 1}
NULL
{"a": 3}
