# name: test/sql/json/table/read_json_filter_pushdown.test
# description: Filters pushed into read_json return what the same filters return above the scan
# group: [table]

require json

require skip_reload

statement ok
COPY (SELECT i AS id, i % 7 AS grp, 'name' || i AS name, DATE '2024-01-01' + (i % 100)::INTEGER AS day, CASE WHEN i % 5 = 0 THEN NULL ELSE i * 1.5 END AS amount, {'k': i % 3, 'v': [i, i + 1]} AS nested FROM range(5000) t(i)) TO '{TEMP_DIR}/pushdown.json' (FORMAT json);

statement ok
CREATE TABLE expected AS SELECT * FROM read_json('{TEMP_DIR}/pushdown.json');

query II
EXPLAIN SELECT id FROM read_json('{TEMP_DIR}/pushdown.json') WHERE grp = 3
----
physical_plan	<REGEX>:.*READ_JSON.*Column Filter: grp = 3.*

query I
SELECT count(*) FROM (
	(SELECT * FROM read_json('{TEMP_DIR}/pushdown.json') WHERE grp = 3 AND id > 1000 EXCEPT ALL SELECT * FROM expected WHERE grp = 3 AND id > 1000)
	UNION ALL
	(SELECT * FROM expected WHERE grp = 3 AND id > 1000 EXCEPT ALL SELECT * FROM read_json('{TEMP_DIR}/pushdown.json') WHERE grp = 3 AND id > 1000)
)
----
0

query I
SELECT count(*) FROM read_json('{TEMP_DIR}/pushdown.json') WHERE amount IS NULL
----
1000

query I
SELECT count(*) FROM (
	(SELECT * FROM read_json('{TEMP_DIR}/pushdown.json') WHERE day BETWEEN DATE '2024-02-01' AND DATE '2024-02-10' AND name LIKE 'name1%' EXCEPT ALL SELECT * FROM expected WHERE day BETWEEN DATE '2024-02-01' AND DATE '2024-02-10' AND name LIKE 'name1%')
	UNION ALL
	(SELECT * FROM expected WHERE day BETWEEN DATE '2024-02-01' AND DATE '2024-02-10' AND name LIKE 'name1%' EXCEPT ALL SELECT * FROM read_json('{TEMP_DIR}/pushdown.json') WHERE day BETWEEN DATE '2024-02-01' AND DATE '2024-02-10' AND name LIKE 'name1%')
)
----
0

query III
SELECT id, name, nested.v FROM read_json('{TEMP_DIR}/pushdown.json') WHERE id IN (7, 4999, 12) ORDER BY id
----
7	name7	[7, 8]
12	name12	[12, 13]
4999	name4999	[4999, 5000]

query II
SELECT id, name FROM read_json('{TEMP_DIR}/pushdown.json') WHERE id = 4999
----
4999	name4999

query II
SELECT id, grp FROM read_json('{TEMP_DIR}/pushdown.json') WHERE grp = 0 AND name = 'name4998'
----
4998	0

query I
SELECT json->>'id' FROM read_json_objects('{TEMP_DIR}/pushdown.json') WHERE json LIKE '%"id":4999,%'
----
4999

query I
SELECT count(*) FROM read_json('{TEMP_DIR}/pushdown.json') WHERE nested.k = 1
----
1667

query I
SELECT (SELECT count(*) FROM read_json('{TEMP_DIR}/pushdown.json') WHERE file_row_number < 10000) = (WITH r AS MATERIALIZED (SELECT file_row_number FROM read_json('{TEMP_DIR}/pushdown.json')) SELECT count(*) FROM r WHERE file_row_number < 10000)
----
true

query I
SELECT count(*) FROM read_json_objects('{TEMP_DIR}/pushdown.json') WHERE json LIKE '%"grp":3%'
----
714

statement ok
COPY (SELECT * FROM (VALUES (1, 'a', '10'), (2, 'b', 'x'), (3, 'c', '30')) t(id, name, num)) TO '{TEMP_DIR}/pushdown_errors.json' (FORMAT json);

query II
SELECT id, num FROM read_json('{TEMP_DIR}/pushdown_errors.json', columns = {'id': 'INTEGER', 'name': 'VARCHAR', 'num': 'INTEGER'}) WHERE id = 3
----
3	30

statement error
SELECT id, num FROM read_json('{TEMP_DIR}/pushdown_errors.json', columns = {'id': 'INTEGER', 'name': 'VARCHAR', 'num': 'INTEGER'}) WHERE id = 2
----
<REGEX>:.*JSON transform error.*line 2.*

query II
SELECT id, num FROM read_json('{TEMP_DIR}/pushdown_errors.json', columns = {'id': 'INTEGER', 'name': 'VARCHAR', 'num': 'INTEGER'}, ignore_errors = true) WHERE id >= 2 ORDER BY id
----
2	NULL
3	30

statement error
SELECT id FROM read_json('{TEMP_DIR}/pushdown_errors.json', columns = {'id': 'INTEGER', 'name': 'VARCHAR', 'num': 'INTEGER'}) WHERE num > 5
----
<REGEX>:.*JSON transform error.*line 2.*

statement error
SELECT id, num FROM read_json('{TEMP_DIR}/pushdown_errors.json', columns = {'id': 'INTEGER', 'name': 'VARCHAR', 'num': 'INTEGER'}) WHERE id >= 1
----
<REGEX>:.*JSON transform error.*line 2.*
