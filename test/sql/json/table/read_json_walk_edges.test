# name: test/sql/json/table/read_json_walk_edges.test
# description: values the walk of a pushed predicate cannot decide itself are left to the transform, which gives the value, a NULL under ignore_errors or the error; rejected records drop every filter column
# group: [table]

require json

statement ok
COPY (SELECT line FROM (VALUES
	(1, '{"id":1,"st":{"A":7}}'),
	(2, '{"id":2,"st":{"a":null}}'),
	(3, '{"id":3,"st":{"a":"7"}}'),
	(4, '{"id":4,"st":{"a":true}}'),
	(5, '{"id":5,"st":{"a":7.0}}'),
	(6, '{"id":6,"st":{"ab":7}}'),
	(7, '{"id":7,"st":{"a":7}}'),
	(8, '{"id":8,"st":{"a":8}}'),
	(9, '{"id":9,"st":null}'),
	(10, '{"id":10}'),
	(11, '{"id":11,"st":{"d":2,"f":true,"v":"x"}}'),
	(12, '{"id":12,"st":{"d":1,"f":false,"v":5}}'),
	(13, '{"id":13,"st":{"d":"2.5","f":1,"v":true}}')
) t(i, line) ORDER BY i) TO '{TEMP_DIR}/walk_values.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
CREATE MACRO walk_values() AS {'id': 'BIGINT', 'st': 'STRUCT(a BIGINT, d DOUBLE, f BOOLEAN, v VARCHAR)'};

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_values.ndjson', columns = walk_values()) WHERE st.a = 7 ORDER BY id;
----
1
3
5
7

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_values.ndjson', columns = walk_values()) WHERE st.d > 1.5 ORDER BY id;
----
11
13

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_values.ndjson', columns = walk_values()) WHERE st.f = true ORDER BY id;
----
11
13

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_values.ndjson', columns = walk_values()) WHERE st.v = 'x' ORDER BY id;
----
11

statement ok
COPY (SELECT line FROM (VALUES
	(1, '{"id":1,"st":{"ti":1000}}'),
	(2, '{"id":2,"st":{"ti":-1000}}'),
	(3, '{"id":3,"st":{"ti":5}}'),
	(4, '{"id":4,"st":{"a":[7]}}'),
	(5, '{"id":5,"st":5}'),
	(6, '{"id":6,"st":{"s":5}}'),
	(7, '{"id":7,"st":{"a":123456789012345678901234567890}}'),
	(8, '{"id":8,"st":{"a":1,"a":2}}'),
	(9, '{"id":9,"st":{"A":1,"A":2}}'),
	(10, '{"id":10,"st":{"a":7,"s":{"b":1}}}'),
	(11, '{"id":11,"st":{"a":18446744073709551615}}')
) t(i, line) ORDER BY i) TO '{TEMP_DIR}/walk_lenient.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
CREATE MACRO walk_lenient() AS {'id': 'BIGINT', 'st': 'STRUCT(a BIGINT, ti TINYINT, s STRUCT(b BIGINT))'};

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_lenient.ndjson', columns = walk_lenient(), ignore_errors = true) WHERE st.ti = 5 ORDER BY id;
----
3

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_lenient.ndjson', columns = walk_lenient(), ignore_errors = true) WHERE st.a = 7 ORDER BY id;
----
10

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_lenient.ndjson', columns = walk_lenient(), ignore_errors = true) WHERE st.s.b = 1 ORDER BY id;
----
10

statement ok
CREATE MACRO walk_bad() AS {'id': 'BIGINT', 'st': 'STRUCT(a BIGINT, f BOOLEAN, v VARCHAR)'};

statement ok
COPY (SELECT '{"id":1,"st":{"v":"\q"}}' AS line) TO '{TEMP_DIR}/walk_bad_escape.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_bad_escape.ndjson', columns = walk_bad()) WHERE st.v = 'x';
----
<REGEX>:.*Malformed JSON in file.*in line 1: invalid escaped sequence in string.*

statement ok
COPY (SELECT '{"id":1,"st":{"f":tru}}' AS line) TO '{TEMP_DIR}/walk_bad_true.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_bad_true.ndjson', columns = walk_bad()) WHERE st.f = true;
----
<REGEX>:.*Malformed JSON in file.*in line 1: invalid literal, expected 'true'.*

statement ok
COPY (SELECT '{"id":1,"st":{"a":nul}}' AS line) TO '{TEMP_DIR}/walk_bad_null.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_bad_null.ndjson', columns = walk_bad()) WHERE st.a = 7;
----
<REGEX>:.*Malformed JSON in file.*in line 1: invalid literal, expected 'null'.*

foreach record {"id":1,"st":{"a"7}} {"id":1,"st":{"a":1]} {"id":1,"st":{"a":{"b":1}

statement ok
COPY (SELECT '{record}' AS line) TO '{TEMP_DIR}/walk_bad_shape.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_bad_shape.ndjson', columns = walk_bad()) WHERE st.a = 7;
----
<REGEX>:.*Malformed JSON in file.*in line 1: .*

query I
SELECT count(*) FROM read_ndjson('{TEMP_DIR}/walk_bad_shape.ndjson', columns = walk_bad(), ignore_errors = true) WHERE st.a = 7;
----
0

endloop

statement ok
COPY (SELECT line FROM (VALUES
	(1, '{"st":{"a":7},"id":1,"dt":"2020-01-01"}'),
	(2, '{"st":{"a":8},"id":2,"dt":"2020-01-02"}'),
	(3, '{"id":3,"dt":"2020-01-03","st":{"a":9}}'),
	(4, '{"id":4,"dt":"1999-01-01","st":{"a":7}}'),
	(5, '{"id":5,"dt":"2020-01-05","st":{"a":7}}')
) t(i, line) ORDER BY i) TO '{TEMP_DIR}/walk_rejects.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT id FROM read_ndjson('{TEMP_DIR}/walk_rejects.ndjson', columns = {'id': 'BIGINT', 'dt': 'DATE', 'st': 'STRUCT(a BIGINT)'}) WHERE st.a = 7 AND id > 0 AND dt > DATE '2000-01-01' ORDER BY id;
----
1
5

statement ok
COPY (SELECT line FROM (VALUES
	(1, '{"id":1,"x":1,"y":10}'),
	(2, '{"id":2,"y":20}'),
	(3, '{"id":3,"x":3}'),
	(4, '{"id":4,"x":4,"y":40}')
) t(i, line) ORDER BY i) TO '{TEMP_DIR}/optional_filter.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, x, y FROM read_ndjson('{TEMP_DIR}/optional_filter.ndjson', columns = {'id': 'BIGINT', 'x': 'BIGINT', 'y': 'BIGINT'}) WHERE x IN (1, 3, 5) ORDER BY id;
----
1	1	10
3	3	NULL

statement ok
COPY (SELECT '{"id":6,"j":{"a":1]}' AS line) TO '{TEMP_DIR}/late_bad_json.ndjson' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT id, j FROM read_ndjson('{TEMP_DIR}/late_bad_json.ndjson', columns = {'id': 'BIGINT', 'j': 'JSON'}) WHERE id > 5;
----
<REGEX>:.*Malformed JSON in file.*in line 1: .*

query II
SELECT id, j FROM read_ndjson('{TEMP_DIR}/late_bad_json.ndjson', columns = {'id': 'BIGINT', 'j': 'JSON'}, ignore_errors = true) WHERE id > 5;
----
