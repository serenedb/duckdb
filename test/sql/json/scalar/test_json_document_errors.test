----
Malformed JSON at byte 8 of input: invalid escaped sequence in string

statement error
SELECT '["ok\n", "\uD800"]'::JSON;
----
Malformed JSON at byte 10 of input: no low surrogate in string

statement error
SELECT ('["ok\n", "' || chr(92) || 'uD800' || chr(92) || 'u0041"]')::JSON;
----
Malformed JSON at byte 10 of input: no low surrogate in string

statement error
