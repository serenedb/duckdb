----
Malformed JSON at byte 10 of input: no low surrogate in string

statement error
SELECT '"\uDC00"'::JSON;
----
Malformed JSON at byte 1 of input: invalid high surrogate in string

statement error
SELECT replace('["a~"b", "~b~f~r~t", "~u0041~uE000", "~x"]', '~', chr(92))::JSON;
----
Malformed JSON at byte 38 of input: invalid escaped sequence in string

statement error
