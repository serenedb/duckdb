AlterStatement <- 'ALTER' AlterOptions

AlterOptions <- AlterSetSchemaStmt / AlterTableStmt / AlterViewStmt / AlterIndexStmt / AlterFunctionStmt / AlterSequenceStmt / AlterDatabaseStmt / AlterSchemaStmt / AlterJobStmt / AlterDomainStmt

AlterSetSchemaStmt <- SetSchemaEntryType IfExists? BaseTableName 'SET' 'SCHEMA' ColId
SetSchemaEntryType <- CommentTable / CommentView / CommentSequence / CommentType / CommentFunction / SetSchemaProcedure /
        CommentMacroTable / CommentMacro / SetSchemaDictionary / SetSchemaDomain
SetSchemaProcedure <- 'PROCEDURE'
SetSchemaDictionary <- 'TEXT' 'SEARCH' 'DICTIONARY'
SetSchemaDomain <- 'DOMAIN'

AlterJobStmt <- 'JOB' IfExists? QualifiedName AlterJobAction
AlterJobAction <- AlterJobRename / AlterJobSuspend / AlterJobResume / AlterJobSetSchedule
AlterJobRename <- 'RENAME' 'TO' ColId
AlterJobSuspend <- 'SUSPEND'
AlterJobResume <- 'RESUME'
AlterJobSetSchedule <- 'SET' 'SCHEDULE' JobSchedule

AlterIndexStmt <- 'INDEX' IfExists? BaseTableName AlterIndexAlter
AlterIndexAlter <- RenameAlter / SetOptions / ResetOptions
AlterFunctionStmt <- 'FUNCTION' IfExists? QualifiedName RenameAlter

AlterTableStmt <- 'TABLE' IfExists? 'ONLY'? BaseTableName List(AlterTableOptions)
AlterSchemaStmt <- 'SCHEMA' IfExists? QualifiedName AlterSchemaOptions
AlterSchemaOptions <- RenameAlter / SetOptions / ResetOptions

AlterTableOptions <- AddColumn / DropConstraint / DropColumn / AlterColumn / AddConstraint / ChangeNullability /
        RenameConstraint / RenameColumn / RenameAlter / SetPartitionedBy / ResetPartitionedBy / SetSortedBy / ResetSortedBy / SetOptions / ResetOptions /
        EnableTrigger / DisableTrigger

AddConstraint <- 'ADD' TopLevelConstraint
EnableTrigger <- 'ENABLE' TriggerFireMode? 'TRIGGER' TriggerTarget
DisableTrigger <- 'DISABLE' 'TRIGGER' TriggerTarget
TriggerFireMode <- ReplicaFireMode / AlwaysFireMode
ReplicaFireMode <- 'REPLICA'
AlwaysFireMode <- 'ALWAYS'
TriggerTarget <- AllTriggers / UserTriggers / ColId
AllTriggers <- 'ALL'
UserTriggers <- 'USER'
DropConstraint <- 'DROP' 'CONSTRAINT' IfExists? ConstraintName DropBehavior?
RenameConstraint <- 'RENAME' 'CONSTRAINT' ConstraintName 'TO' ConstraintName
AddColumn <- 'ADD' 'COLUMN'? IfNotExists? AddColumnEntry
AddColumnEntry <- DottedIdentifier Type? GeneratedColumn? ColumnConstraint*
DropColumn <- 'DROP' 'COLUMN'? IfExists? NestedColumnName DropBehavior?
AlterColumn <- 'ALTER' 'COLUMN'? NestedColumnName AlterColumnEntry
RenameColumn <- 'RENAME' 'COLUMN'? NestedColumnName 'TO' ColIdOrString
NestedColumnName <- IdentifierDot* ColumnName
IdentifierDot <- Identifier '.'
RenameAlter <- 'RENAME' 'TO' ColIdOrString
SetPartitionedBy <- 'SET' 'PARTITIONED' 'BY' Parens(List(Expression))
ResetPartitionedBy <- 'RESET' 'PARTITIONED' 'BY'
SetSortedBy <- 'SET' 'SORTED' 'BY' Parens(OrderByExpressions)
ResetSortedBy <- 'RESET' 'SORTED' 'BY'
SetOptions <- 'SET' RelOptionList
ResetOptions <- 'RESET' RelOptionList

AlterColumnEntry <- AddOrDropDefault / ChangeNullability / AlterType

AddOrDropDefault <- AddDefault / DropDefault
AddDefault <- 'SET' 'DEFAULT' Expression
DropDefault <- 'DROP' 'DEFAULT'

ChangeNullability <- DropOrSet 'NOT' 'NULL'
DropOrSet <- DropNullability / SetNullability
DropNullability <- 'DROP'
SetNullability <- 'SET'

AlterType <- SetData? 'TYPE' Type? ColumnCollation? UsingExpression?
SetData <- 'SET' 'DATA'?
UsingExpression <- 'USING' Expression

AlterViewStmt <- 'VIEW' IfExists? BaseTableName RenameAlter

AlterSequenceStmt <- 'SEQUENCE' IfExists? QualifiedSequenceName AlterSequenceOptions

QualifiedSequenceName <- CatalogQualification? SchemaQualification? SequenceName

AlterSequenceOptions <- RenameAlterSequenceOptions / SetSequenceOption
RenameAlterSequenceOptions <- RenameAlter
SetSequenceOption <- AlterSequenceOption+
AlterSequenceOption <- SeqRestart / SequenceOption
SeqRestart <- 'RESTART' SeqRestartValue?
SeqRestartValue <- 'WITH'? Expression

AlterDatabaseStmt <- 'DATABASE' IfExists? Identifier 'SET' 'ALIAS' 'TO' Identifier

AlterDomainStmt <- 'DOMAIN' QualifiedName AlterDomainAction
AlterDomainAction <- DomainSetDefault / DomainDropDefault / DomainSetNotNull / DomainDropNotNull /
        AddDomainConstraint / DomainDropConstraint / DomainRenameConstraint / ValidateConstraint / DomainRename
DomainSetDefault <- 'SET' 'DEFAULT' Expression
DomainDropDefault <- 'DROP' 'DEFAULT'
DomainSetNotNull <- 'SET' 'NOT' 'NULL'
DomainDropNotNull <- 'DROP' 'NOT' 'NULL'
DomainDropConstraint <- 'DROP' 'CONSTRAINT' IfExists? ConstraintName DropBehavior?
DomainRenameConstraint <- 'RENAME' 'CONSTRAINT' ConstraintName 'TO' ConstraintName
DomainRename <- 'RENAME' 'TO' ColIdOrString
AddDomainConstraint <- 'ADD' DomainConstraint NotValid?
NotValid <- 'NOT' 'VALID'
ValidateConstraint <- 'VALIDATE' 'CONSTRAINT' ConstraintName
