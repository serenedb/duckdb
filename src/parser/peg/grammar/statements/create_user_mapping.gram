CreateUserMappingStatement <- 'CREATE' 'USER' 'MAPPING' IfNotExists? 'FOR' UserMappingRole 'SERVER' QualifiedName ServerOptions?
DropUserMappingStatement <- 'DROP' 'USER' 'MAPPING' IfExists? 'FOR' UserMappingRole 'SERVER' QualifiedName
UserMappingRole <- 'PUBLIC' / 'CURRENT_USER' / 'USER' / ColLabel
