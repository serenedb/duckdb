CreateDatabaseStatement <- 'CREATE' 'DATABASE' IfNotExists? CatalogName CreateDatabaseOwner? WithList?
CreateDatabaseOwner <- 'WITH'? 'OWNER' DatabaseOwnerName
DatabaseOwnerName <- '='? ColId
DropDatabaseStatement <- 'DROP' 'DATABASE' IfExists? CatalogName DropDatabaseForce? DropBehavior?
DropDatabaseForce <- '(' 'FORCE' ')'
